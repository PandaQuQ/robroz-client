  "base": {
    "brand": {
      "ink": "#16181d",
      "paper": "#f4f1ea",
      "orange": "#c8551f",
      "white": "#ffffff",
      "rule": "orange only marks the primary action, 'waiting on you' and switch-on; one primary per card"
    },
    "status_dot": {
      "light": {
        "waiting": "#c8551f",
        "done": "#2e7d32",
        "expired": "#9a978f",
        "blocked": "#f5b700"
      },
      "dark": {
        "waiting": "#c8551f",
        "done": "#4f9a53",
        "expired": "#6f6c66",
        "blocked": "#f5b700"
      }
    },
    "status_card": {
      "palette": "robroz-card::palette() (frozen, not restated here)",
      "dark_stroke": "#3f444d"
    },
    "type_scale": {
      "caption": 11,
      "small": 12,
      "meta": 12.5,
      "button": 13,
      "body": 14,
      "list_title": 15,
      "title": 20,
      "display": 22,
      "body_line_height": 22,
      "weights": [
        400,
        700
      ],
      "mono": "IBM Plex Mono"
    },
    "space": [
      2,
      4,
      6,
      8,
      10,
      12,
      14,
      16,
      20,
      24,
      32
    ],
    "layout": {
      "stream_padding": 16,
      "card_gap": 10,
      "min_width": 390,
      "narrow_breakpoint": 480,
      "touch_floor_narrow": 44,
      "rule": "width <= 480 or touch input: sidebar collapses to a drawer, option buttons wrap, every hit area >= max(skin.touch_target, 44)"
    },
    "contrast": {
      "text_min": 4.5,
      "graphics_min": 3.0,
      "glass_rule": "measure text against the worst case: 100% orange wallpaper under the window tint + surface"
    },
    "chat": {
      "column_max": 720,
      "column_margin": 24,
      "bubble_radius": 18,
      "bubble_pad_v": 10,
      "bubble_pad_h": 14,
      "own_radius": 16,
      "own_corner": 4,
      "gap_in": 4,
      "gap_between": 16,
      "group_secs": 300,
      "avatar": 24,
      "avatar_gap": 8,
      "date_size": 12,
      "date_gap": 16,
      "composer_height": 48,
      "composer_radius": 20,
      "composer_pad_left": 16,
      "composer_send": 32,
      "composer_send_inset": 8,
      "composer_bottom": 16,
      "composer_send_empty_opacity": 0.4,
      "time_size": 12,
      "bubble_max_frac": 0.68,
      "bubble_compact_frac": 0.8,
      "bubble_mine_size": 15,
      "thumb_size": 56
