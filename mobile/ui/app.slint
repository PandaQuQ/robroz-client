// MCP page (PR6). Values pushed from `robroz_tokens::mcp`.
export global McpMetrics {
    in property <length> capsule: 36px;
    in property <length> capsule-pad: 14px;
    in property <length> capsule-gap: 8px;
    in property <length> capsule-text: 14px;
    in property <length> row: 64px;
    in property <length> icon: 44px;
    in property <length> icon-r: 12px;
    in property <length> icon-gap: 12px;
    in property <length> icon-text: 18px;
    in property <length> row-name: 15px;
    in property <length> row-sub: 12px;
    in property <length> connect-h: 32px;
    in property <length> count-text: 13px;
    in property <length> connected-dot: 6px;
}

// One MCP server row. `connected` shows the inert label instead of Connect.
export struct McpLine {
    id: string,
    name: string,
    letter: string,
    sub: string,
    connected: bool,
}

// One shape cell or colour swatch of the avatar picker.
export struct PickerCell {
    glyph: image,
    fill: color,
    selected: bool,
}

export struct SessionRow {
    id: string,
    name: string,
    unread: int,
    preview: string,
    time: string,
    glyph: image,
    has-glyph: bool,
}

export struct FindHit {
    message-id: string,
    snippet: string,
    when: string,
    author: string,
}

export struct MemberLine {
    name: string,
    detail: string,
    glyph: image,
    has-glyph: bool,
}

// kind: 0 own bubble (right), 1 bro bubble (left), 2 status card (left),
// 3 date separator (centred).
export struct StatusRun {
    text: string,
    mono: bool,
}

export struct ChatRow {
    kind: int,
    name: string,
    text: string,
    status: string,
    step: string,
    progress: string,
    // Raw failure detail: 12px monospace, muted, selectable, untranslated.
    detail: string,
    fill: color,
    text-color: color,
    dot: color,
    show-name: bool,
    show-avatar: bool,
    initial: string,
    // The bro's avatar (shape + colour); empty for own rows.
    glyph: image,
    has-glyph: bool,
    pad-top: length,
    time: string,
    // Process line: task id to expand, › when there are recorded steps.
    // Digit runs are `mono` so only the figures are tabular; words stay
    // in the UI font. `status-shrink` cards hug their content.
    task-id: string,
    expandable: bool,
    status-runs: [StatusRun],
    status-shrink: bool,
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> primary: true;
    callback clicked();
    min-height: 48px;
    border-radius: 10px;
    background: root.primary ? Brand.accent : Brand.paper;
    border-width: root.primary ? 0px : 1px;
    border-color: Brand.rule;
    Text {
        text: root.text;
        color: root.primary ? Brand.on-accent : Brand.ink;
        font-size: 16px;
        font-weight: 600;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value;
    in property <bool> secret: false;
    in property <string> placeholder;
    in property <string> reveal-text;
    callback edited();
    callback reveal();
    spacing: 6px;
    Text { text: root.label; color: Brand.muted; font-size: 13px; }
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            height: 48px;
            horizontal-stretch: 1;
            border-radius: 10px;
            background: Brand.surface;
            border-width: 1px;
            border-color: Brand.border;
            if root.value == "": Text {
                x: 12px;
                width: parent.width - 24px;
                height: 100%;
                text: root.placeholder;
                color: Brand.muted;
                font-size: 16px;
                vertical-alignment: center;
            }
            TextInput {
                x: 12px;
                width: parent.width - 24px;
                height: 100%;
                text <=> root.value;
                color: Brand.ink;
                font-size: 16px;
                single-line: true;
                input-type: root.secret ? InputType.password : InputType.text;
                vertical-alignment: center;
                edited => { root.edited(); }
                accepted => { root.edited(); }
            }
        }
        if root.reveal-text != "": Rectangle {
            width: 64px;
            height: 48px;
            Text {
                text: root.reveal-text;
                color: Brand.accent;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea { clicked => { root.reveal(); } }
        }
    }
}

component Header inherits HorizontalLayout {
    in property <string> title;
    in property <string> back-text;
    in property <bool> has-back: false;
    in property <bool> has-settings: false;
    callback back();
    callback settings();
    height: 52px;
    alignment: space-between;
    HorizontalLayout {
        alignment: start;
        if root.has-back: Rectangle {
            width: 120px;
            Text {
                x: 0px;
                width: parent.width;
                text: root.back-text;
                color: Brand.accent;
                font-size: 16px;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
            TouchArea { clicked => { root.back(); } }
        }
        if !root.has-back: Text {
            text: root.title;
            color: Brand.ink;
            font-size: 24px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    if root.has-settings: Rectangle {
        width: 52px;
        Text { text: "⚙"; font-size: 22px; color: Brand.muted; }
        TouchArea { clicked => { root.settings(); } }
    }
}

component Avatar inherits Rectangle {
    in property <string> letter;
    width: Metrics.avatar;
    height: Metrics.avatar;
    border-radius: Metrics.avatar / 2;
    border-width: 1.5px;
    border-color: Brand.accent;
    background: transparent;
    Text {
        text: root.letter;
        color: Brand.accent;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// `‹` as a 16px stroked chevron, centred on its box.
component Chevron inherits Path {
    width: HomeMetrics.more-icon;
    height: HomeMetrics.more-icon;
    viewbox-width: 16;
    viewbox-height: 16;
    commands: "M 10 3 L 5 8 L 10 13";
    stroke: Brand.ink;
    stroke-width: 2px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// Round button: `+` text, or a drawn `more` (three dots, 16px) or `back`
// (chevron, 16px). 32px for the ••• and ‹ buttons, 40px for `+`.
component RoundButton inherits Rectangle {
    in property <string> glyph;
    in property <length> size: root.glyph == "+" ? HomeMetrics.float-btn : 32px;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: self.width / 2;
    background: Brand.surface;
    border-width: 1px;
    border-color: Brand.border;
    if root.glyph == "+": Text { text: "+"; color: Brand.ink; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
    if root.glyph == "more": Rectangle {
        width: HomeMetrics.more-icon;
        height: HomeMetrics.more-icon;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        for i in 3: Rectangle {
            width: 2.6px;
            height: 2.6px;
            border-radius: 1.3px;
            background: Brand.ink;
            x: i * (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    if root.glyph == "back": Chevron {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// 160px preview tile (radius 32) with the avatar, then the inline note.
component AvatarPreview inherits VerticalLayout {
    in property <image> glyph;
    in property <string> note;
    spacing: 8px;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: AvatarMetrics.preview;
            height: AvatarMetrics.preview;
            border-radius: AvatarMetrics.preview-radius;
            background: Brand.rule;
            Image { source: root.glyph; width: AvatarMetrics.preview-glyph; height: AvatarMetrics.preview-glyph; }
        }
    }
    // UI姐: one line under the preview, no pop-up.
    if root.note != "": Text {
        text: root.note;
        color: Brand.danger;
        font-size: 13px;
        horizontal-alignment: center;
        overflow: elide;
    }
}

// 12 shapes, six per row (48px cells, 12px gap, two rows), then 10
// colours as 32px circles in 44px hit areas. A phone is too narrow for
// ten 44px targets in one row, so colours wrap five per row.
component AvatarPicker inherits VerticalLayout {
    in property <[PickerCell]> shapes;
    in property <[PickerCell]> swatches;
    callback pick-shape(int);
    callback pick-color(int);
    // Same 8px as the desktop picker (label to grid, label to swatches).
    // vertical-stretch stays 0 so leftover page height cannot inflate
    // the labels and open a ~40px gap under 「形状」 / 「颜色」.
    spacing: 8px;
    alignment: start;
    vertical-stretch: 0;
    property <int> shape-cols: 6;
    property <length> gap: 12px;
    Text { text: Tr.shape; color: Brand.text3; font-size: 13px; vertical-stretch: 0; }
    Rectangle {
        height: 2 * AvatarMetrics.cell + root.gap;
        vertical-stretch: 0;
        for c[i] in root.shapes: Rectangle {
            x: mod(i, root.shape-cols) * (AvatarMetrics.cell + root.gap);
            y: floor(i / root.shape-cols) * (AvatarMetrics.cell + root.gap);
            width: AvatarMetrics.cell;
            height: AvatarMetrics.cell;
            border-radius: AvatarMetrics.cell / 4;
            background: Brand.surface;
            border-width: c.selected ? AvatarMetrics.ring : 1px;
            border-color: c.selected ? Brand.ink : Brand.border;
            Image { source: c.glyph; width: AvatarMetrics.cell-glyph; height: AvatarMetrics.cell-glyph; }
            TouchArea { clicked => { root.pick-shape(i); } }
        }
    }
    // Layout spacing is 8px on both sides of this 8px spacer, so the
    // gap between the shape grid and 「颜色」 is 24px. Label-to-content
    // stays 8px.
    Rectangle { height: 8px; vertical-stretch: 0; }
    Text { text: Tr.color; color: Brand.text3; font-size: 13px; vertical-stretch: 0; }
    Rectangle {
        property <length> step: (self.width - 5 * AvatarMetrics.swatch-hit) / 4 + AvatarMetrics.swatch-hit;
        height: 2 * AvatarMetrics.swatch-hit;
        vertical-stretch: 0;
        for c[i] in root.swatches: Rectangle {
            x: mod(i, 5) * parent.step;
            y: floor(i / 5) * AvatarMetrics.swatch-hit;
            width: AvatarMetrics.swatch-hit;
            height: AvatarMetrics.swatch-hit;
            if c.selected: Rectangle {
                width: AvatarMetrics.swatch + 4 * AvatarMetrics.ring;
                height: self.width;
                border-radius: self.width / 2;
                border-width: AvatarMetrics.ring;
                border-color: Brand.ink;
            }
            Rectangle {
                width: AvatarMetrics.swatch;
                height: AvatarMetrics.swatch;
                border-radius: self.width / 2;
                background: c.fill;
            }
            TouchArea { clicked => { root.pick-color(i); } }
        }
    }
}

// One 36px menu item: text centred vertically, 12px inside the item.
// A 52px settings row: label, optional text2 value, then a tick or `›`.
// `first` hides the 1px divider drawn above every other row.
component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> danger: false;
    in property <bool> chevron: true;
    in property <bool> ticked: false;
    in property <bool> first: true;
    callback clicked();
    height: SettingsMetrics.row;
    if !root.first: Rectangle {
        y: 0;
        height: SettingsMetrics.divider;
        background: Brand.border;
    }
    HorizontalLayout {
        padding-left: SettingsMetrics.side-pad;
        padding-right: SettingsMetrics.side-pad;
        spacing: 8px;
        Text { text: root.label; color: root.danger ? Brand.danger : Brand.ink; font-size: 16px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        if root.value != "": Text { text: root.value; color: Brand.muted; font-size: 16px; vertical-alignment: center; }
        if root.chevron: Text { text: "›"; color: Brand.text3; font-size: 18px; vertical-alignment: center; }
        if root.ticked: Path {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 3.2 8.3 L 6.7 11.8 L 13.1 4.5";
            stroke: Brand.accent;
            stroke-width: 2px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        if !root.chevron && !root.ticked && !root.danger: Rectangle { width: 16px; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// r16 surface card with a hairline, children stacked.
component SettingsCard inherits Rectangle {
    border-radius: SettingsMetrics.card-r;
    background: Brand.surface;
    border-width: 1px;
    border-color: Brand.border;
    clip: true;
    VerticalLayout { @children }
}

component MenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();
    width: 100%;
    height: HomeMetrics.menu-row;
    border-radius: HomeMetrics.menu-r - HomeMetrics.menu-pad;
    Text {
        x: 12px;
        width: parent.width - 24px;
        height: 100%;
        text: root.label;
        color: root.danger ? Brand.danger : Brand.ink;
        font-size: HomeMetrics.menu-text;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// 1px line with 4px above and 4px below.
component MenuDivider inherits Rectangle {
    width: 100%;
    height: 2 * HomeMetrics.menu-divider-gap + 1px;
    Rectangle {
        x: 8px;
        y: HomeMetrics.menu-divider-gap;
        width: parent.width - 16px;
        height: 1px;
        background: Brand.rule;
    }
}

// Popover surface with 4px inner padding. `rows` / `dividers` size it.
component MenuBox inherits Rectangle {
    in property <int> rows: 1;
    in property <int> dividers: 0;
    width: HomeMetrics.menu-w;
    height: 2 * HomeMetrics.menu-pad + root.rows * HomeMetrics.menu-row + root.dividers * (2 * HomeMetrics.menu-divider-gap + 1px);
    border-radius: HomeMetrics.menu-r;
    background: Brand.surface;
    border-width: 1px;
    border-color: Brand.border;
    VerticalLayout {
        padding: HomeMetrics.menu-pad;
        alignment: start;
        @children
    }
}

// 36px capsule; the selected one is inverted (ink fill, paper text).
component Capsule inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: McpMetrics.capsule;
    width: label.preferred-width + 2 * McpMetrics.capsule-pad;
    border-radius: self.height / 2;
    background: root.selected ? Brand.ink : Brand.surface;
    border-width: root.selected ? 0px : 1px;
    border-color: Brand.border;
    label := Text {
        text: root.text;
        color: root.selected ? Brand.paper : Brand.ink;
        font-size: McpMetrics.capsule-text;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component MainWindow inherits Window {
    // 0 connect, 1 sessions, 2 card, 3 settings, 4 create bro, 5 avatar,
    // 6 profile, 7 find, 8 members, 9 settings choice
    in-out property <int> screen: 0;
    in-out property <string> host-url;
    in-out property <string> token;
    in-out property <bool> show-token: false;
    in-out property <bool> token-masked: false;
    in property <string> error-title;
    in property <string> error;
    in property <string> unencrypted-hint;
    in property <bool> busy: false;
    in property <[SessionRow]> sessions;
    in property <[ChatRow]> chat;
    in property <string> chat-title;
    in property <string> chat-note;
    in-out property <string> composer-draft;
    in property <string> composer-hint;
    in-out property <bool> composer-focused: false;
    // Reserved: show the 56px thumbnail row when this is > 0.
    in property <int> attachment-count: 0;
    in property <int> locale-index;
    in property <int> theme-index;
    in property <string> version-text;
    // Chat title capsule: up to three 24px avatars as one image (first on
    // top), its width in px (0 = none), then `title-more` as "+N".
    in property <image> title-avatars;
    in property <float> title-avatars-width;
    in property <int> title-more;
    // Only the bro's owner sees the avatar entry (`…`).
    in property <bool> can-edit-avatar;
    // Working row above the composer; width 0 hides the avatar stack.
    in property <string> working-row;
    in property <image> working-avatars;
    in property <float> working-avatars-width;
    // Reconnecting banner, empty when the stream is fine or the outage is brief.
    in property <string> reconnect-banner;
    in property <int> unread-other;
    in property <bool> group-menu: false;
    in property <bool> self-menu: false;
    in property <bool> can-manage: false;
    in property <bool> delete-open: false;
    in property <bool> copied: false;
    in property <string> group-note;
    in-out property <string> group-edit;
    in property <bool> group-editing: false;
    in property <bool> group-edit-saving: false;
    in property <int> routines-on: -1;
    in property <int> member-count: -1;
    in property <string> me-name;
    in property <string> me-initial;
    in-out property <string> home-query;
    in property <image> profile-avatars;
    in property <float> profile-avatars-width;
    in property <int> profile-more;
    in property <[FindHit]> find-hits;
    in-out property <string> find-query;
    in property <bool> find-busy: false;
    in property <[MemberLine]> members-list;
    // MCP page (screen 9). Filter: 0 all, 1 stdio, 2 HTTP.
    in property <[McpLine]> mcp-rows;
    // Settings shows the MCP row only with a host connection.
    in property <bool> mcp-available: false;
    in property <int> mcp-filter: 0;
    in property <string> mcp-connected-text;
    in property <bool> mcp-categories: false;
    in property <string> mcp-note;
    in property <bool> mcp-loaded: false;
    in property <bool> mcp-busy: false;
    in property <bool> mcp-prompt-open: false;
    in property <string> mcp-prompt-command-text;
    in property <string> mcp-prompt-args-text;
    in property <string> mcp-prompt-note;
    // Create-bro (screen 4) and avatar (screen 5) pages.
    in property <image> avatar-preview;
    in property <string> avatar-note;
    in property <string> avatar-name;
    in property <bool> avatar-stored;
    in property <bool> avatar-busy;
    in property <[PickerCell]> picker-shapes;
    in property <[PickerCell]> picker-swatches;
    in-out property <string> new-bro-name;
    // Added on top of Window.safe-area-insets so desktop shots can show
    // typical phone insets (the desktop backend reports 0).
    in property <length> extra-safe-top: 0px;
    in property <length> extra-safe-bottom: 0px;
    // Palette follows the OS; Rust uses this when Appearance is System.
    out property <bool> os-dark: Palette.color-scheme == ColorScheme.dark;
    callback connect();
    callback host-changed();
    callback token-changed();
    callback toggle-show-token();
    callback open-session(string, string);
    callback back();
    callback open-settings();
    callback set-locale(int);
    callback set-theme(int);
    // Settings choice page (screen 9): 0 Language, 1 Appearance.
    in-out property <int> choice-kind: 0;
    callback open-choice(int);
    callback theme-follow-system();
    callback send();
    callback open-new-bro();
    callback open-avatar();
    callback pick-shape(int);
    callback pick-color(int);
    callback avatar-reset();
    callback create-bro();
    callback page-back();
    callback toggle-process(string);
    callback open-group-menu();
    callback close-menus();
    callback open-group-profile();
    callback open-find();
    callback find-edited();
    callback open-members();
    callback start-edit();
    callback save-edit();
    callback copy-id();
    callback ask-delete();
    callback cancel-delete();
    callback confirm-delete();
    callback open-self-menu();
    callback sign-out();
    callback home-search-edited();
    callback open-hit(string);
    callback open-mcp();
    callback mcp-pick-filter(int);
    callback mcp-connect-server(string);
    callback mcp-approve();
    callback mcp-cancel-prompt();

    changed os-dark => { root.theme-follow-system(); }

    background: Brand.paper;
    preferred-width: 390px;
    preferred-height: 844px;
    min-width: 390px;
    min-height: 844px;

    VerticalLayout {
        padding-left: root.screen == 2 ? Metrics.column-margin : (root.screen == 6 || root.screen == 10 ? HomeMetrics.profile-side : 20px);
        padding-right: root.screen == 2 ? Metrics.column-margin : (root.screen == 6 || root.screen == 10 ? HomeMetrics.profile-side : 20px);
        padding-top: 20px + root.safe-area-insets.top + root.extra-safe-top;
        padding-bottom: root.screen == 2 ? 0 : ((root.screen == 3 || root.screen == 9 || root.screen == 10 ? SettingsMetrics.bottom-pad : 20px) + root.safe-area-insets.bottom + root.extra-safe-bottom);
        spacing: 14px;

        if root.screen == 0: VerticalLayout {
            spacing: 16px;
            alignment: start;
            Header { title: "robroz"; has-settings: true; settings => { root.open-settings(); } }
            Field {
                label: Tr.label-host;
                value <=> root.host-url;
                placeholder: "https://…";
                edited => { root.host-changed(); }
            }
            if root.unencrypted-hint != "": Text {
                text: root.unencrypted-hint;
                color: Brand.muted;
                wrap: word-wrap;
                font-size: 13px;
            }
            Field {
                label: Tr.label-token;
                value <=> root.token;
                secret: !root.show-token && !root.token-masked;
                reveal-text: root.token-masked ? "" : (root.show-token ? Tr.hide : Tr.show);
                reveal => { root.toggle-show-token(); }
                edited => { root.token-changed(); }
            }
            Pill {
                text: root.busy ? Tr.connecting : Tr.connect;
                clicked => { if !root.busy { root.connect(); } }
            }
            if root.error-title != "" || root.error != "": VerticalLayout {
                spacing: 4px;
                if root.error-title != "": Text {
                    text: root.error-title;
                    color: Brand.accent;
                    wrap: word-wrap;
                    font-size: 13px;
                    font-weight: 600;
                }
                if root.error != "": Text {
                    text: root.error;
                    color: Brand.accent;
                    wrap: word-wrap;
                    font-size: 13px;
                }
            }
        }

        if root.screen == 1: Rectangle {
            VerticalLayout {
                spacing: 12px;
                // `+` over the top-right; no hero avatar.
                Rectangle {
                    height: HomeMetrics.float-btn;
                    RoundButton {
                        x: parent.width - self.width;
                        y: 0px;
                        glyph: "+";
                        clicked => { root.open-new-bro(); }
                    }
                }
                if root.sessions.length == 0: Text {
                    text: Tr.empty-chats;
                    color: Brand.muted;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                ListView {
                    vertical-stretch: 1;
                    for s in root.sessions: Rectangle {
                        height: HomeMetrics.row;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: stretch;
                            // 56px face slot: a DM avatar (48px) or up to three
                            // overlapped 24px group avatars, centred.
                            VerticalLayout {
                                alignment: center;
                                width: HomeMetrics.row-face-w;
                                if s.has-glyph: Image {
                                    source: s.glyph;
                                    width: HomeMetrics.row-face-w;
                                    height: HomeMetrics.row-avatar;
                                    image-fit: contain;
                                }
                                if !s.has-glyph: HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: HomeMetrics.row-avatar;
                                        height: HomeMetrics.row-avatar;
                                        border-radius: HomeMetrics.row-avatar / 2;
                                        background: Brand.surface;
                                        border-width: 1px;
                                        border-color: Brand.border;
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                alignment: center;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: s.name;
                                        color: Brand.ink;
                                        font-size: HomeMetrics.row-name;
                                        font-weight: 700;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        width: 52px;
                                        Text {
                                            text: s.time;
                                            color: Brand.text3;
                                            font-size: HomeMetrics.row-time;
                                            horizontal-alignment: right;
                                        }
                                        if s.unread > 0: HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: HomeMetrics.unread-dot;
                                                height: HomeMetrics.unread-dot;
                                                border-radius: HomeMetrics.unread-dot / 2;
                                                background: Brand.accent;
                                            }
                                        }
                                    }
                                }
                                // No preview: no second line, the name stays centred.
                                if s.preview != "": Text {
                                    text: s.preview;
                                    color: Brand.muted;
                                    font-size: HomeMetrics.row-preview;
                                    overflow: elide;
                                }
                            }
                        }
                        TouchArea { clicked => { root.open-session(s.id, s.name); } }
                    }
                }
                // Self row + search capsule, 16px off the bottom (layout
                // padding already includes the safe area).
                // The row never changes look when its menu is open: no card.
                Rectangle {
                    height: HomeMetrics.card-row;
                    border-radius: HomeMetrics.menu-r;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 16px;
                                background: Brand.surface;
                                border-width: 1px;
                                border-color: Brand.border;
                                Text { text: root.me-initial; color: Brand.ink; font-size: 15px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        Text {
                            text: root.me-name;
                            color: Brand.ink;
                            font-size: 16px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    TouchArea { clicked => { root.open-self-menu(); } }
                }
                Rectangle {
                    height: HomeMetrics.search;
                    border-radius: HomeMetrics.search / 2;
                    background: Brand.surface;
                    border-width: 1px;
                    border-color: Brand.border;
                    if root.home-query == "": Text {
                        x: 16px;
                        width: parent.width - 32px;
                        height: 100%;
                        text: Tr.search-placeholder;
                        color: Brand.muted;
                        font-size: 15px;
                        vertical-alignment: center;
                    }
                    TextInput {
                        x: 16px;
                        width: parent.width - 32px;
                        height: 100%;
                        text <=> root.home-query;
                        color: Brand.ink;
                        font-size: 15px;
                        single-line: true;
                        vertical-alignment: center;
                        edited => { root.home-search-edited(); }
                    }
                }
                Rectangle { height: HomeMetrics.search-lift; }
            }
            if root.self-menu: Rectangle {
                x: 0px;
                width: 100%;
                height: 100%;
                TouchArea { clicked => { root.close-menus(); } }
                // 4px above the self row (row, 12px gap, search, 12px gap, lift).
                MenuBox {
                    rows: 2;
                    dividers: 1;
                    x: 0px;
                    y: parent.height - HomeMetrics.search-lift - 12px - HomeMetrics.search - 12px - HomeMetrics.card-row - HomeMetrics.menu-gap - self.height;
                    width: min(HomeMetrics.menu-w, parent.width);
                    MenuRow { label: Tr.settings-title; clicked => { root.close-menus(); root.open-settings(); } }
                    MenuDivider { }
                    MenuRow { label: Tr.sign-out; danger: true; clicked => { root.sign-out(); } }
                }
            }
        }

        if root.screen == 2: VerticalLayout {
            spacing: 10px;
            width: 100%;
            HorizontalLayout {
                spacing: 8px;
                height: AvatarMetrics.title-height;
                Rectangle {
                    horizontal-stretch: 0;
                    border-radius: HomeMetrics.float-btn / 2;
                    background: Brand.paper;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: HomeMetrics.back-gap;
                        VerticalLayout {
                            alignment: center;
                            Chevron { }
                        }
                        if root.unread-other > 0: Text {
                            text: root.unread-other > 99 ? "99+" : root.unread-other;
                            color: Brand.ink;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea { clicked => { root.back(); } }
                }
                Rectangle {
                    horizontal-stretch: 0;
                    border-radius: self.height / 2;
                    background: Brand.surface;
                    border-width: 1px;
                    border-color: Brand.border;
                    HorizontalLayout {
                        padding-left: root.title-avatars-width > 0 ? AvatarMetrics.title-pad : 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        if root.title-avatars-width > 0: VerticalLayout {
                            alignment: center;
                            width: root.title-avatars-width * 1px;
                            Image {
                                source: root.title-avatars;
                                width: root.title-avatars-width * 1px;
                                height: AvatarMetrics.title-size;
                            }
                        }
                        if root.title-more > 0: Text {
                            text: "+" + root.title-more;
                            color: Brand.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.chat-title;
                            color: Brand.ink;
                            font-size: 17px;
                            font-weight: 700;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    RoundButton { glyph: "more"; clicked => { root.open-group-menu(); } }
                }
            }
            if root.chat-note != "": Text { text: root.chat-note; color: Brand.muted; wrap: word-wrap; }
            if root.reconnect-banner != "": HorizontalLayout {
                width: 100%;
                alignment: center;
                padding-top: 4px;
                padding-bottom: 8px;
                Rectangle {
                    border-radius: 12px;
                    background: Brand.surface;
                    border-width: 1px;
                    border-color: Brand.border;
                    HorizontalLayout {
                        padding-top: 4px;
                        padding-bottom: 4px;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: start;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            // Same token as the 「卡住」 (stuck) dot, not brand orange.
                            background: Brand.stuck;
                        }
                        Text {
                            text: root.reconnect-banner;
                            color: Brand.ink;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            ScrollView {
                vertical-stretch: 1;
                width: 100%;
                feed := VerticalLayout {
                    width: 100%;
                    spacing: 0px;
                    alignment: start;
                    property <length> col-w: self.width;
                    property <length> gutter: Metrics.avatar + Metrics.avatar-gap;
                    for row in root.chat: VerticalLayout {
                        width: 100%;
                        padding-top: row.pad-top;
                        if row.kind == 3: Text {
                            width: 100%;
                            text: row.text;
                            color: Brand.text3;
                            font-size: Metrics.date-size;
                            horizontal-alignment: center;
                        }
                        if row.kind == 0: HorizontalLayout {
                            width: 100%;
                            alignment: end;
                            VerticalLayout {
                                spacing: 2px;
                                alignment: end;
                                Rectangle {
                                    background: Brand.own-bg;
                                    border-radius: Metrics.bubble-radius;
                                    max-width: feed.col-w * 0.75;
                                    VerticalLayout {
                                        padding-left: Metrics.bubble-pad-h;
                                        padding-right: Metrics.bubble-pad-h;
                                        padding-top: Metrics.bubble-pad-v;
                                        padding-bottom: Metrics.bubble-pad-v;
                                        Text {
                                            text: row.text;
                                            color: Brand.own-text;
                                            font-size: Metrics.bubble-mine-size;
                                            wrap: word-wrap;
                                            horizontal-alignment: left;
                                        }
                                    }
                                }
                                if row.time != "": Text {
                                    text: row.time;
                                    color: Brand.text3;
                                    font-size: Metrics.time-size;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                        if row.kind == 1: VerticalLayout {
                            width: 100%;
                            spacing: 2px;
                            HorizontalLayout {
                                width: 100%;
                                alignment: start;
                                vertical-stretch: 0;
                                VerticalLayout {
                                    width: Metrics.avatar;
                                    alignment: end;
                                    vertical-stretch: 1;
                                    if row.show-avatar && row.has-glyph: Image { source: row.glyph; width: Metrics.avatar; height: Metrics.avatar; }
                                    if row.show-avatar && !row.has-glyph: Avatar { letter: row.initial; }
                                    if !row.show-avatar: Rectangle { width: Metrics.avatar; height: 1px; }
                                }
                                Rectangle { width: Metrics.avatar-gap; }
                                VerticalLayout {
                                    spacing: 3px;
                                    max-width: feed.col-w - feed.gutter;
                                    if row.show-name: Text {
                                        text: row.name;
                                        color: Brand.muted;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        background: Brand.surface;
                                        border-radius: Metrics.bubble-radius;
                                        border-width: 1px;
                                        border-color: Brand.border;
                                        VerticalLayout {
                                            padding-left: Metrics.bubble-pad-h;
                                            padding-right: Metrics.bubble-pad-h;
                                            padding-top: Metrics.bubble-pad-v;
                                            padding-bottom: Metrics.bubble-pad-v;
                                            Text {
                                                text: row.text;
                                                color: Brand.ink;
                                                font-size: 16px;
                                                wrap: word-wrap;
                                                horizontal-alignment: left;
                                            }
                                        }
                                    }
                                }
                            }
                            if row.time != "": HorizontalLayout {
                                width: 100%;
                                Rectangle { width: feed.gutter; }
                                Text {
                                    text: row.time;
                                    color: Brand.text3;
                                    font-size: Metrics.time-size;
                                    horizontal-alignment: left;
                                }
                            }
                        }
                        if row.kind == 2: VerticalLayout {
                            width: 100%;
                            spacing: 2px;
                            HorizontalLayout {
                                width: 100%;
                                alignment: start;
                                VerticalLayout {
                                    width: Metrics.avatar;
                                    alignment: end;
                                    vertical-stretch: 1;
                                    if row.show-avatar && row.has-glyph: Image { source: row.glyph; width: Metrics.avatar; height: Metrics.avatar; }
                                    if row.show-avatar && !row.has-glyph: Avatar { letter: row.initial; }
                                    if !row.show-avatar: Rectangle { width: Metrics.avatar; height: 1px; }
                                }
                                Rectangle { width: Metrics.avatar-gap; }
                                VerticalLayout {
                                    spacing: 3px;
                                    max-width: feed.col-w - feed.gutter;
                                    if row.show-name: Text {
                                        text: row.name;
                                        color: Brand.muted;
                                        font-size: 12px;
                                    }
                                    HorizontalLayout {
                                        // Fixed column width (not parent.width) so shrink
                                        // cards do not form a binding loop.
                                        width: feed.col-w - feed.gutter;
                                        alignment: start;
                                        Rectangle {
                                            // Unfilled status card: border only.
                                            // Line-only cards shrink to content; others fill the column.
                                            horizontal-stretch: row.status-shrink ? 0 : 1;
                                            background: transparent;
                                            border-radius: 14px;
                                            border-width: 1px;
                                            border-color: Brand.border;
                                            VerticalLayout {
                                                padding: 14px;
                                                spacing: 4px;
                                                alignment: start;
                                                HorizontalLayout {
                                                    alignment: start;
                                                    spacing: 8px;
                                                    Rectangle {
                                                        width: 8px;
                                                        height: 8px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 4px;
                                                        background: row.dot;
                                                    }
                                                    if row.step != "": Text {
                                                        text: row.step;
                                                        color: Brand.ink;
                                                        font-size: 14px;
                                                        horizontal-alignment: left;
                                                        vertical-alignment: center;
                                                    }
                                                    if row.status-runs.length == 0: Text {
                                                        text: row.status;
                                                        color: Brand.ink;
                                                        font-size: 14px;
                                                        font-weight: 600;
                                                        wrap: word-wrap;
                                                        horizontal-alignment: left;
                                                        vertical-alignment: center;
                                                    }
                                                    if row.status-runs.length > 0: HorizontalLayout {
                                                        alignment: start;
                                                        spacing: 0px;
                                                        for run in row.status-runs: HorizontalLayout {
                                                            if run.mono: Text {
                                                                text: run.text;
                                                                color: Brand.ink;
                                                                font-size: 14px;
                                                                font-weight: 600;
                                                                font-family: Metrics.mono-font;
                                                                vertical-alignment: center;
                                                            }
                                                            if !run.mono: Text {
                                                                text: run.text;
                                                                color: Brand.ink;
                                                                font-size: 14px;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                    if row.expandable: Text {
                                                        text: "›";
                                                        color: Brand.text3;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                if row.expandable: TouchArea {
                                                    clicked => { root.toggle-process(row.task-id); }
                                                }
                                                if row.progress != "": Text {
                                                    text: row.progress;
                                                    color: Brand.ink;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                    horizontal-alignment: left;
                                                }
                                                if row.detail != "": TextInput {
                                                    text: row.detail;
                                                    read-only: true;
                                                    color: Brand.text3;
                                                    font-size: 12px;
                                                    font-family: Metrics.mono-font;
                                                    wrap: word-wrap;
                                                    horizontal-alignment: left;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if row.time != "": HorizontalLayout {
                                width: 100%;
                                Rectangle { width: feed.gutter; }
                                Text {
                                    text: row.time;
                                    color: Brand.text3;
                                    font-size: Metrics.time-size;
                                    horizontal-alignment: left;
                                }
                            }
                        }
                    }
                }
            }
            if root.working-row != "": HorizontalLayout {
                padding-top: 8px;
                // Text bottom to composer top is 8px.
                padding-bottom: 8px;
                spacing: 8px;
                alignment: start;
                if root.working-avatars-width > 0: Image {
                    source: root.working-avatars;
                    width: root.working-avatars-width * 1px;
                    height: 16px;
                }
                Text {
                    text: root.working-row;
                    color: Brand.text3;
                    font-size: 12px;
                    vertical-alignment: bottom;
                    overflow: elide;
                }
            }
            Rectangle {
                width: 100%;
                border-radius: Metrics.composer-radius;
                border-width: 1px;
                border-color: Brand.border;
                background: Brand.surface;
                VerticalLayout {
                    // Reserved 56px attachment-thumbnail row. Hidden while
                    // there are no attachments (the feature is not wired).
                    if root.attachment-count > 0: Rectangle {
                        height: Metrics.thumb-size;
                    }
                    HorizontalLayout {
                        padding-left: Metrics.composer-pad-left;
                        padding-right: Metrics.composer-send-inset;
                        padding-top: Metrics.composer-send-inset;
                        padding-bottom: Metrics.composer-send-inset;
                        min-height: Metrics.composer-height;
                        spacing: 8px;
                        // stretch (not start/end) so horizontal-stretch is
                        // honoured; start/end pack children and ignore
                        // stretch, which pushed a short hint against the
                        // send button. Left inset is 16px, same as desktop.
                        alignment: stretch;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: Metrics.composer-send;
                            if root.composer-draft == "" && !root.composer-focused: HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                alignment: start;
                                Text {
                                    height: 100%;
                                    text: root.composer-hint;
                                    color: Brand.text3;
                                    font-size: 16px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle { horizontal-stretch: 1; height: 1px; }
                            }
                            if root.composer-draft == "" && !root.composer-focused: TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.composer-focused = true; }
                            }
                            if root.composer-draft != "" || root.composer-focused: TextInput {
                                width: 100%;
                                height: 100%;
                                text <=> root.composer-draft;
                                color: Brand.ink;
                                font-size: 16px;
                                single-line: true;
                                vertical-alignment: center;
                                init => { self.focus(); }
                                accepted => {
                                    if root.composer-draft != "" { root.send(); }
                                    if root.composer-draft == "" { root.composer-focused = false; }
                                }
                            }
                        }
                        Rectangle {
                            width: Metrics.composer-send;
                            height: Metrics.composer-send;
                            border-radius: Metrics.composer-send / 2;
                            background: Brand.accent-strong;
                            opacity: root.composer-draft == "" ? Metrics.composer-send-empty-opacity : 1;
                            Text { text: "↑"; color: Brand.on-accent; font-size: 16px; }
                            if root.composer-draft != "": TouchArea { clicked => { root.send(); } }
                        }
                    }
                }
            }
            Rectangle {
                height: Metrics.composer-bottom + root.safe-area-insets.bottom + root.extra-safe-bottom;
            }
        }

        if root.screen == 4: VerticalLayout {
            spacing: 16px;
            HorizontalLayout {
                height: 52px;
                Text { text: Tr.add-bro; color: Brand.ink; font-size: 20px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: Tr.cancel;
                    color: Brand.accent;
                    font-size: 16px;
                    vertical-alignment: center;
                    TouchArea { clicked => { root.page-back(); } }
                }
            }
            AvatarPreview { glyph: root.avatar-preview; note: root.avatar-note; }
            Rectangle {
                height: AvatarMetrics.name-height;
                border-radius: AvatarMetrics.name-radius;
                background: Brand.surface;
                border-width: 1px;
                border-color: name-input.has-focus ? Brand.accent : Brand.border;
                if root.new-bro-name == "": Text {
                    x: 16px;
                    width: parent.width - 32px;
                    height: 100%;
                    text: Tr.name-placeholder;
                    color: Brand.muted;
                    font-size: 16px;
                    vertical-alignment: center;
                }
                name-input := TextInput {
                    x: 16px;
                    width: parent.width - 32px;
                    height: 100%;
                    text <=> root.new-bro-name;
                    color: Brand.ink;
                    font-size: 16px;
                    single-line: true;
                    vertical-alignment: center;
                    enabled: !root.avatar-busy;
                    accepted => { if root.new-bro-name != "" { root.create-bro(); } }
                }
            }
            AvatarPicker {
                shapes: root.picker-shapes;
                swatches: root.picker-swatches;
                pick-shape(i) => { root.pick-shape(i); }
                pick-color(i) => { root.pick-color(i); }
            }
            Rectangle { vertical-stretch: 1; }
            Rectangle {
                height: AvatarMetrics.name-height;
                border-radius: AvatarMetrics.name-radius;
                background: Brand.accent;
                opacity: (root.new-bro-name == "" || root.avatar-busy) ? AvatarMetrics.create-empty-opacity : 1;
                Text { text: Tr.create; color: Brand.on-accent; font-size: 16px; font-weight: 600; }
                TouchArea { clicked => { if root.new-bro-name != "" && !root.avatar-busy { root.create-bro(); } } }
            }
        }

        if root.screen == 5: VerticalLayout {
            spacing: 16px;
            HorizontalLayout {
                height: 52px;
                Text { text: Tr.avatar-title; color: Brand.ink; font-size: 20px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; RoundButton { glyph: "back"; clicked => { root.page-back(); } } }
            }
            AvatarPreview { glyph: root.avatar-preview; note: root.avatar-note; }
            Text { text: root.avatar-name; color: Brand.ink; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
            AvatarPicker {
                shapes: root.picker-shapes;
                swatches: root.picker-swatches;
                pick-shape(i) => { root.pick-shape(i); }
                pick-color(i) => { root.pick-color(i); }
            }
            Rectangle { vertical-stretch: 1; }
            if root.avatar-stored: Rectangle {
                height: AvatarMetrics.name-height;
                border-radius: AvatarMetrics.name-radius;
                background: Brand.surface;
                border-width: 1px;
                border-color: Brand.border;
                Text { text: Tr.use-default; color: Brand.ink; font-size: 16px; }
                TouchArea { clicked => { root.avatar-reset(); } }
            }
        }

        if root.screen == 3: VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                height: HomeMetrics.float-btn + 16px;
                spacing: 12px;
                VerticalLayout { alignment: center; RoundButton { glyph: "back"; clicked => { root.back(); } } }
                Text { text: Tr.settings-title; color: Brand.ink; font-size: SettingsMetrics.title; font-weight: 700; vertical-alignment: center; }
            }
            Flickable {
                VerticalLayout {
                    spacing: SettingsMetrics.group-gap;
                    alignment: start;
                    VerticalLayout {
                        spacing: SettingsMetrics.group-title-gap;
                        HorizontalLayout {
                            padding-left: SettingsMetrics.side-pad;
                            Text { text: Tr.settings-general; color: Brand.text3; font-size: SettingsMetrics.group-title; }
                        }
                        SettingsCard {
                            SettingsRow {
                                label: Tr.language;
                                value: root.locale-index == 1 ? Tr.locale-zh : Tr.locale-en;
                                clicked => { root.open-choice(0); }
                            }
                            SettingsRow {
                                first: false;
                                label: Tr.appearance;
                                value: root.theme-index == 1 ? Tr.theme-light : root.theme-index == 2 ? Tr.theme-dark : Tr.theme-system;
                                clicked => { root.open-choice(1); }
                            }
                        }
                    }
                    if root.mcp-available: SettingsCard {
                        SettingsRow { label: Tr.mcp-title; clicked => { root.open-mcp(); } }
                    }
                    SettingsCard {
                        SettingsRow { label: Tr.sign-out; danger: true; chevron: false; clicked => { root.sign-out(); } }
                    }
                    Text {
                        text: root.version-text;
                        color: Brand.text3;
                        font-size: SettingsMetrics.version;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        if root.screen == 9: VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                height: HomeMetrics.float-btn + 16px;
                spacing: 12px;
                VerticalLayout { alignment: center; RoundButton { glyph: "back"; clicked => { root.back(); } } }
                Text { text: root.choice-kind == 0 ? Tr.language : Tr.appearance; color: Brand.ink; font-size: SettingsMetrics.title; font-weight: 700; vertical-alignment: center; }
            }
            if root.choice-kind == 0: SettingsCard {
                SettingsRow { label: Tr.locale-en; chevron: false; ticked: root.locale-index == 0; clicked => { root.set-locale(0); } }
                SettingsRow { first: false; label: Tr.locale-zh; chevron: false; ticked: root.locale-index == 1; clicked => { root.set-locale(1); } }
            }
            if root.choice-kind == 1: SettingsCard {
                SettingsRow { label: Tr.theme-system; chevron: false; ticked: root.theme-index == 0; clicked => { root.set-theme(0); } }
                SettingsRow { first: false; label: Tr.theme-light; chevron: false; ticked: root.theme-index == 1; clicked => { root.set-theme(1); } }
                SettingsRow { first: false; label: Tr.theme-dark; chevron: false; ticked: root.theme-index == 2; clicked => { root.set-theme(2); } }
            }
            Rectangle { vertical-stretch: 1; }
        }

        if root.screen == 6: VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                height: HomeMetrics.float-btn;
                VerticalLayout { alignment: center; RoundButton { glyph: "back"; clicked => { root.back(); } } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; RoundButton { glyph: "more"; clicked => { root.open-group-menu(); } } }
            }
            VerticalLayout {
                spacing: HomeMetrics.profile-name-gap;
                alignment: center;
                if root.profile-avatars-width > 0: Image {
                    source: root.profile-avatars;
                    width: root.profile-avatars-width * 1px;
                    height: HomeMetrics.profile-avatar;
                }
                if  !root.group-editing: Text {
                    text: root.chat-title;
                    color: Brand.ink;
                    font-size: HomeMetrics.profile-name;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                if root.group-editing: Rectangle {
                    height: HomeMetrics.profile-edit-h;
                    width: 220px;
                    border-radius: 16px;
                    background: Brand.surface;
                    border-width: 1px;
                    border-color: Brand.border;
                    TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: 100%;
                        text <=> root.group-edit;
                        color: Brand.ink;
                        font-size: 16px;
                        single-line: true;
                        vertical-alignment: center;
                        accepted => { root.save-edit(); }
                    }
                }
                if root.can-manage &&  !root.group-editing: Rectangle {
                    height: HomeMetrics.profile-edit-h;
                    width: 80px;
                    border-radius: HomeMetrics.profile-edit-h / 2;
                    background: Brand.surface;
                    Text { text: Tr.profile-edit; color: Brand.ink; font-size: 13px; }
                    TouchArea { clicked => { root.start-edit(); } }
                }
                if root.can-manage && root.group-editing: Rectangle {
                    height: HomeMetrics.profile-edit-h;
                    width: 80px;
                    border-radius: HomeMetrics.profile-edit-h / 2;
                    background: Brand.accent;
                    Text { text: Tr.create; color: Brand.on-accent; font-size: 13px; }
                    TouchArea { clicked => { if !root.group-edit-saving { root.save-edit(); } } }
                }
            }
            if root.copied: Text {
                text: Tr.profile-copied;
                color: Brand.muted;
                font-size: 13px;
                horizontal-alignment: center;
            }
            if root.group-note != "": Text {
                text: root.group-note;
                color: Brand.danger;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            // Layout spacing is 12px, plus 12px here: 24px from Edit to the card.
            VerticalLayout {
                padding-top: HomeMetrics.profile-card-gap - 12px;
                vertical-stretch: 0;
                alignment: start;
            Rectangle {
                border-radius: HomeMetrics.card-r;
                background: Brand.surface;
                VerticalLayout {
                    if root.routines-on >= 0: Rectangle {
                        height: HomeMetrics.card-row;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            Text { text: Tr.profile-routines; color: Brand.ink; font-size: 16px; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: root.routines-on; color: Brand.muted; font-size: 14px; vertical-alignment: center; }
                        }
                    }
                    if root.member-count >= 0 && root.can-manage: Rectangle {
                        height: HomeMetrics.card-row;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            Text { text: Tr.profile-members; color: Brand.ink; font-size: 16px; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: root.member-count; color: Brand.muted; font-size: 14px; vertical-alignment: center; }
                            Text { text: "›"; color: Brand.text3; font-size: 18px; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.open-members(); } }
                    }
                }
            }
            }
            Rectangle { vertical-stretch: 1; }
        }

        if root.screen == 7: VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                height: HomeMetrics.float-btn;
                spacing: 8px;
                VerticalLayout { alignment: center; RoundButton { glyph: "back"; clicked => { root.back(); } } }
                Text { text: Tr.find-title; color: Brand.ink; font-size: 20px; font-weight: 700; vertical-alignment: center; }
            }
            Rectangle {
                height: HomeMetrics.search;
                border-radius: HomeMetrics.search / 2;
                background: Brand.surface;
                border-width: 1px;
                border-color: Brand.border;
                if root.find-query == "": Text {
                    x: 16px; width: parent.width - 32px; height: 100%;
                    text: Tr.find-placeholder; color: Brand.muted; font-size: 15px; vertical-alignment: center;
                }
                TextInput {
                    x: 16px; width: parent.width - 32px; height: 100%;
                    text <=> root.find-query; color: Brand.ink; font-size: 15px;
                    single-line: true; vertical-alignment: center;
                    edited => { root.find-edited(); }
                    accepted => { root.find-edited(); }
                }
            }
            if root.find-hits.length == 0: Text {
                text: root.find-busy ? "" : (root.find-query == "" ? Tr.find-empty : Tr.find-no-results);
                color: Brand.muted;
                wrap: word-wrap;
            }
            ListView {
                for h in root.find-hits: Rectangle {
                    height: 72px;
                    VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        HorizontalLayout {
                            Text { text: h.author; color: Brand.ink; font-size: 14px; font-weight: 700; overflow: elide; horizontal-stretch: 1; }
                            Text { text: h.when; color: Brand.text3; font-size: 12px; }
                        }
                        Text { text: h.snippet; color: Brand.muted; font-size: 14px; overflow: elide; wrap: no-wrap; }
                    }
                    TouchArea { clicked => { root.open-hit(h.message-id); } }
                }
            }
        }

        if root.screen == 8: VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                height: HomeMetrics.float-btn;
                spacing: 8px;
                VerticalLayout { alignment: center; RoundButton { glyph: "back"; clicked => { root.back(); } } }
                Text { text: Tr.members-title; color: Brand.ink; font-size: 20px; font-weight: 700; vertical-alignment: center; }
            }
            ListView {
                for m in root.members-list: Rectangle {
                    height: HomeMetrics.card-row;
                    HorizontalLayout {
                        spacing: 12px;
                        padding-left: 4px;
                        padding-right: 4px;
                        if m.has-glyph: Image { source: m.glyph; width: 40px; height: 40px; }
                        if !m.has-glyph: Rectangle {
                            width: 40px; height: 40px; border-radius: 20px;
                            background: Brand.surface; border-width: 1px; border-color: Brand.border;
                        }
                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            Text { text: m.name; color: Brand.ink; font-size: 16px; overflow: elide; }
                            if m.detail != "": Text { text: m.detail; color: Brand.text3; font-size: 12px; overflow: elide; }
                        }
                    }
                }
            }
        }
        // MCP page: capsules, 64px rows with a 44px r12 tile, Connect or the
        // inert Connected label.
        if root.screen == 10: VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                height: HomeMetrics.float-btn + 16px;
                spacing: 12px;
                VerticalLayout { alignment: center; RoundButton { glyph: "back"; clicked => { root.back(); } } }
                Text { text: Tr.mcp-title; color: Brand.ink; font-size: SettingsMetrics.title; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                if root.mcp-connected-text != "": VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.mcp-connected-text;
                        color: Brand.muted;
                        font-size: McpMetrics.count-text;
                        vertical-alignment: center;
                    }
                }
            }
            if root.mcp-categories: HorizontalLayout {
                spacing: McpMetrics.capsule-gap;
                alignment: start;
                Capsule { text: Tr.mcp-all; selected: root.mcp-filter == 0; clicked => { root.mcp-pick-filter(0); } }
                Capsule { text: "stdio"; selected: root.mcp-filter == 1; clicked => { root.mcp-pick-filter(1); } }
                Capsule { text: "HTTP"; selected: root.mcp-filter == 2; clicked => { root.mcp-pick-filter(2); } }
            }
            if root.mcp-note != "": Text { text: root.mcp-note; color: Brand.muted; font-size: 13px; wrap: word-wrap; }
            if root.mcp-loaded && root.mcp-rows.length == 0 && root.mcp-note == "": Text {
                text: Tr.mcp-empty; color: Brand.muted; font-size: 14px; wrap: word-wrap;
            }
            ListView {
                for r in root.mcp-rows: Rectangle {
                    height: McpMetrics.row;
                    HorizontalLayout {
                        spacing: McpMetrics.icon-gap;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: McpMetrics.icon;
                                height: McpMetrics.icon;
                                border-radius: McpMetrics.icon-r;
                                background: Brand.segment-fill;
                                border-width: 1px;
                                border-color: Brand.border;
                                Text { text: r.letter; color: Brand.muted; font-size: McpMetrics.icon-text; font-weight: 700; }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: r.name; color: Brand.ink; font-size: McpMetrics.row-name; font-weight: 600; overflow: elide; }
                            Text { text: r.sub; color: Brand.text3; font-size: McpMetrics.row-sub; overflow: elide; }
                        }
                        // Dot vertically centred with the label; the group is
                        // right-aligned to the same edge as the Connect capsule.
                        if r.connected: HorizontalLayout {
                            spacing: 6px;
                            alignment: end;
                            vertical-stretch: 0;
                            horizontal-stretch: 0;
                            height: McpMetrics.connect-h;
                            Rectangle {
                                width: McpMetrics.connected-dot;
                                height: McpMetrics.connected-dot;
                                y: (parent.height - self.height) / 2;
                                border-radius: self.height / 2;
                                background: Brand.done;
                                vertical-stretch: 0;
                                horizontal-stretch: 0;
                            }
                            Text {
                                text: Tr.mcp-connected;
                                color: Brand.muted;
                                font-size: McpMetrics.capsule-text;
                                vertical-alignment: center;
                                vertical-stretch: 0;
                                horizontal-stretch: 0;
                            }
                        }
                        if !r.connected: Rectangle {
                            height: McpMetrics.connect-h;
                            width: connect-label.preferred-width + 2 * McpMetrics.capsule-pad;
                            vertical-stretch: 0;
                            horizontal-stretch: 0;
                            border-radius: self.height / 2;
                            background: Brand.surface;
                            border-width: 1px;
                            border-color: Brand.border;
                            connect-label := Text { text: Tr.mcp-connect; color: Brand.ink; font-size: McpMetrics.capsule-text; font-weight: 600; }
                            TouchArea { clicked => { if !root.mcp-busy { root.mcp-connect-server(r.id); } } }
                        }
                    }
                }
            }
        }
    }

    // stdio command approval: bottom sheet with the exact command and args.
    if root.screen == 10 && root.mcp-prompt-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { clicked => { root.mcp-cancel-prompt(); } }
        Rectangle {
            y: parent.height - self.height;
            width: 100%;
            border-top-left-radius: HomeMetrics.card-r;
            border-top-right-radius: HomeMetrics.card-r;
            height: mcp-sheet.preferred-height;
            background: Brand.paper;
            TouchArea { }
            mcp-sheet := VerticalLayout {
                alignment: start;
                padding: 20px;
                padding-bottom: 20px + root.safe-area-insets.bottom + root.extra-safe-bottom;
                spacing: 8px;
                Text { text: Tr.mcp-prompt-command; color: Brand.muted; font-size: 12px; }
                Text { text: root.mcp-prompt-command-text; color: Brand.ink; font-size: 13px; font-family: Metrics.mono-font; wrap: char-wrap; }
                Text { text: Tr.mcp-prompt-args; color: Brand.muted; font-size: 12px; }
                Text { text: root.mcp-prompt-args-text; color: Brand.ink; font-size: 13px; font-family: Metrics.mono-font; wrap: char-wrap; }
                Text { text: Tr.mcp-runs-local; color: Brand.text3; font-size: 12px; wrap: word-wrap; }
                if root.mcp-prompt-note != "": Text { text: root.mcp-prompt-note; color: Brand.danger; font-size: 13px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px;
                    padding-top: 4px;
                    Rectangle {
                        height: 48px;
                        // Equal widths: stretch from a zero preferred width.
                        preferred-width: 0px;
                        horizontal-stretch: 1;
                        border-radius: 10px;
                        background: Brand.surface;
                        Text { text: Tr.cancel; color: Brand.ink; font-size: 16px; font-weight: 600; }
                        TouchArea { clicked => { root.mcp-cancel-prompt(); } }
                    }
                    Rectangle {
                        height: 48px;
                        // Equal widths: stretch from a zero preferred width.
                        preferred-width: 0px;
                        horizontal-stretch: 1;
                        border-radius: 10px;
                        background: Brand.accent;
                        Text { text: Tr.mcp-approve-run; color: Brand.on-accent; font-size: 16px; font-weight: 600; }
                        TouchArea { clicked => { if !root.mcp-busy { root.mcp-approve(); } } }
                    }
                }
            }
        }
    }

    // `•••` popovers: right-aligned to the 32px button, 4px below it. The
    // header is 40px tall and the button is centred in it, so the popover
    // starts one header height under the safe-area top padding.
    if root.group-menu && (root.screen == 2 || root.screen == 6): Rectangle {
        width: 100%;
        height: 100%;
        TouchArea { clicked => { root.close-menus(); } }
        if root.screen == 2: MenuBox {
            rows: root.can-manage ? 5 : 2;
            dividers: root.can-manage ? 1 : 0;
            x: parent.width - Metrics.column-margin - self.width;
            y: 20px + root.safe-area-insets.top + root.extra-safe-top + AvatarMetrics.title-height;
            MenuRow { label: Tr.menu-profile; clicked => { root.open-group-profile(); } }
            MenuRow { label: Tr.menu-find; clicked => { root.open-find(); } }
            if root.can-manage: MenuRow { label: Tr.menu-rename; clicked => { root.open-group-profile(); root.start-edit(); } }
            if root.can-manage: MenuRow { label: Tr.profile-members; clicked => { root.open-group-profile(); root.open-members(); } }
            if root.can-manage: MenuDivider { }
            if root.can-manage: MenuRow { label: Tr.menu-delete; danger: true; clicked => { root.ask-delete(); } }
        }
        if root.screen == 6: MenuBox {
            rows: root.can-manage ? 2 : 1;
            dividers: root.can-manage ? 1 : 0;
            x: parent.width - HomeMetrics.profile-side - self.width;
            y: 20px + root.safe-area-insets.top + root.extra-safe-top + HomeMetrics.float-btn;
            MenuRow { label: Tr.profile-copy-id; clicked => { root.copy-id(); } }
            if root.can-manage: MenuDivider { }
            if root.can-manage: MenuRow { label: Tr.menu-delete; danger: true; clicked => { root.ask-delete(); } }
        }
    }

    if root.delete-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { clicked => { root.cancel-delete(); } }
        Rectangle {
            y: parent.height - self.height;
            width: 100%;
            border-top-left-radius: HomeMetrics.card-r;
            border-top-right-radius: HomeMetrics.card-r;
            background: Brand.paper;
            VerticalLayout {
                padding: 20px;
                padding-bottom: 20px + root.safe-area-insets.bottom + root.extra-safe-bottom;
                spacing: 12px;
                Text { text: Tr.delete-title; color: Brand.ink; font-size: 18px; font-weight: 700; wrap: word-wrap; }
                Text { text: Tr.delete-body; color: Brand.muted; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        height: 48px;
                        horizontal-stretch: 1;
                        border-radius: 10px;
                        background: Brand.surface;
                        Text { text: Tr.cancel; color: Brand.ink; font-size: 16px; font-weight: 600; }
                        TouchArea { clicked => { root.cancel-delete(); } }
                    }
                    Rectangle {
                        height: 48px;
                        horizontal-stretch: 1;
                        border-radius: 10px;
                        background: Brand.danger;
                        Text { text: Tr.delete-confirm; color: #ffffff; font-size: 16px; font-weight: 600; }
                        TouchArea { clicked => { root.confirm-delete(); } }
                    }
                }
            }
        }
    }
}
