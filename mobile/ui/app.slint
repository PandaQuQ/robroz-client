import { ListView, AboutSlint, ScrollView, Palette } from "std-widgets.slint";

// Colours are pushed from Rust (`robroz_tokens` / `Skin`). Nothing here
// restates a hex value. Status card fill/text still come from robroz-card.
export global Brand {
    in property <color> paper;
    in property <color> ink;
    in property <color> muted;
    in property <color> rule;
    in property <color> accent;
    in property <color> accent-strong;
    in property <color> on-accent;
    in property <color> surface;
    in property <color> border;
    in property <color> own-bg;
    in property <color> own-text;
    in property <color> bro-bg;
    in property <color> bro-border;
    in property <color> segment-fill;
    in property <color> segment-text;
    in property <color> text3;
    in property <color> danger;
    // Stuck / "pay attention" yellow; used by the reconnect capsule.
    in property <color> stuck;
}

// Lengths from robroz-tokens `base.chat`. Rust pushes the values; this
// file does not restate the numbers.
export global Metrics {
    // Platform monospace family for raw detail lines (set from Rust).
    in property <string> mono-font: "monospace";
    in property <length> column-margin;
    in property <length> bubble-radius;
    in property <length> bubble-pad-v;
    in property <length> bubble-pad-h;
    in property <length> gap-in;
    in property <length> gap-between;
    in property <length> avatar;
    in property <length> avatar-gap;
    in property <length> date-size;
    in property <length> date-gap;
    in property <length> composer-height;
    in property <length> composer-radius;
    in property <length> composer-pad-left;
    in property <length> composer-send;
    in property <length> composer-send-inset;
    in property <length> composer-bottom;
    in property <float> composer-send-empty-opacity;
    in property <length> bubble-mine-size;
    in property <length> thumb-size;
    in property <length> time-size;
}

// Every string comes from the robroz-ui i18n keys, set from Rust.
export global Tr {
    in property <string> title-chats;
    in property <string> empty-chats;
    in property <string> label-host;
    in property <string> label-token;
    in property <string> connect;
    in property <string> connecting;
    in property <string> show;
    in property <string> hide;
    in property <string> back;
    in property <string> settings;
    in property <string> language;
    in property <string> locale-en;
    in property <string> locale-zh;
    in property <string> appearance;
    in property <string> theme-system;
    in property <string> theme-light;
    in property <string> theme-dark;
    in property <string> about;
    in property <string> version;
    in property <string> send;
    in property <string> add-bro;
    in property <string> name-placeholder;
    in property <string> create;
    in property <string> cancel;
    in property <string> avatar-title;
    in property <string> shape;
    in property <string> color;
    in property <string> use-default;
    in property <string> search-placeholder;
    in property <string> menu-profile;
    in property <string> menu-find;
    in property <string> menu-delete;
    in property <string> profile-edit;
    in property <string> profile-routines;
    in property <string> profile-members;
    in property <string> profile-copy-id;
    in property <string> profile-copied;
    in property <string> delete-title;
    in property <string> delete-body;
    in property <string> find-title;
    in property <string> find-placeholder;
    in property <string> find-empty;
    in property <string> find-no-results;
    in property <string> members-title;
    in property <string> settings-title;
    in property <string> sign-out;
}

// Bro avatar sizes from robroz-tokens `base.avatar` (pushed from Rust).
export global AvatarMetrics {
    in property <length> title-height;
    in property <length> title-size;
    in property <length> title-overlap;
    in property <length> title-pad;
    in property <length> more-button;
    in property <length> preview;
    in property <length> preview-glyph;
    in property <length> preview-radius;
    in property <length> name-height;
    in property <length> name-radius;
    in property <length> cell;
    in property <length> cell-glyph;
    in property <length> swatch;
    in property <length> swatch-hit;
    in property <length> ring;
    in property <float> create-empty-opacity;
}

// Home list, menus and profile (PR4). Values pushed from `robroz_tokens::home`.
export global HomeMetrics {
    in property <length> main-bro: 96px;
    in property <length> main-bro-name: 13px;
    in property <length> row: 72px;
    in property <length> row-avatar: 48px;
    in property <length> row-name: 16px;
    in property <length> row-time: 12px;
    in property <length> row-preview: 14px;
    in property <length> unread-dot: 8px;
    in property <length> search: 48px;
    in property <length> search-lift: 16px;
    in property <length> float-btn: 40px;
    in property <length> menu-w: 220px;
    in property <length> menu-r: 16px;
    in property <length> menu-gap: 8px;
    in property <length> menu-row: 48px;
    in property <length> menu-text: 15px;
    in property <length> profile-avatar: 96px;
    in property <length> profile-name: 22px;
    in property <length> profile-name-gap: 12px;
    in property <length> profile-edit-h: 32px;
    in property <length> card-r: 16px;
    in property <length> card-row: 52px;
}

// One shape cell or colour swatch of the avatar picker.
export struct PickerCell {
    glyph: image,
    fill: color,
    selected: bool,
}

export struct SessionRow {
    id: string,
    name: string,
    unread: int,
    preview: string,
    time: string,
    glyph: image,
    has-glyph: bool,
}

export struct FindHit {
    message-id: string,
    snippet: string,
    when: string,
    author: string,
}

export struct MemberLine {
    name: string,
    detail: string,
    glyph: image,
    has-glyph: bool,
}

// kind: 0 own bubble (right), 1 bro bubble (left), 2 status card (left),
// 3 date separator (centred).
export struct StatusRun {
    text: string,
    mono: bool,
}

export struct ChatRow {
    kind: int,
    name: string,
    text: string,
    status: string,
    step: string,
    progress: string,
    // Raw failure detail: 12px monospace, muted, selectable, untranslated.
    detail: string,
    fill: color,
    text-color: color,
    dot: color,
    show-name: bool,
    show-avatar: bool,
    initial: string,
    // The bro's avatar (shape + colour); empty for own rows.
    glyph: image,
    has-glyph: bool,
    pad-top: length,
    time: string,
    // Process line: task id to expand, › when there are recorded steps.
    // Digit runs are `mono` so only the figures are tabular; words stay
    // in the UI font. `status-shrink` cards hug their content.
    task-id: string,
    expandable: bool,
    status-runs: [StatusRun],
    status-shrink: bool,
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> primary: true;
    callback clicked();
    min-height: 48px;
    border-radius: 10px;
    background: root.primary ? Brand.accent : Brand.paper;
    border-width: root.primary ? 0px : 1px;
    border-color: Brand.rule;
    Text {
        text: root.text;
        color: root.primary ? Brand.on-accent : Brand.ink;
        font-size: 16px;
        font-weight: 600;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// Language / Appearance segment: selected fill and text come from the
// same tokens as the desktop client (border+text on dark, control_checked
// + text on light).
component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    min-height: 36px;
    horizontal-stretch: 1;
    border-radius: 8px;
    background: root.selected ? Brand.segment-fill : transparent;
    Text {
        text: root.text;
        color: root.selected ? Brand.segment-text : Brand.ink;
        font-size: 15px;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component SegmentBar inherits HorizontalLayout {
    in property <string> left-text;
    in property <string> mid-text;
    in property <string> right-text;
    in property <int> selected;
    callback picked(int);
    spacing: 4px;
    height: 40px;
    Segment { text: root.left-text; selected: root.selected == 0; clicked => { root.picked(0); } }
    if root.mid-text != "": Segment { text: root.mid-text; selected: root.selected == 1; clicked => { root.picked(1); } }
    Segment {
        text: root.right-text;
        selected: root.mid-text == "" ? root.selected == 1 : root.selected == 2;
        clicked => { root.picked(root.mid-text == "" ? 1 : 2); }
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value;
    in property <bool> secret: false;
    in property <string> placeholder;
    in property <string> reveal-text;
    callback edited();
    callback reveal();
    spacing: 6px;
    Text { text: root.label; color: Brand.muted; font-size: 13px; }
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            height: 48px;
            horizontal-stretch: 1;
            border-radius: 10px;
            background: Brand.surface;
            border-width: 1px;
            border-color: Brand.border;
            if root.value == "": Text {
                x: 12px;
                width: parent.width - 24px;
                height: 100%;
                text: root.placeholder;
                color: Brand.muted;
                font-size: 16px;
                vertical-alignment: center;
            }
            TextInput {
                x: 12px;
                width: parent.width - 24px;
                height: 100%;
                text <=> root.value;
                color: Brand.ink;
                font-size: 16px;
                single-line: true;
                input-type: root.secret ? InputType.password : InputType.text;
                vertical-alignment: center;
                edited => { root.edited(); }
                accepted => { root.edited(); }
            }
        }
        if root.reveal-text != "": Rectangle {
            width: 64px;
            height: 48px;
            Text {
                text: root.reveal-text;
                color: Brand.accent;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea { clicked => { root.reveal(); } }
        }
    }
}

component Header inherits HorizontalLayout {
    in property <string> title;
    in property <string> back-text;
    in property <bool> has-back: false;
    in property <bool> has-settings: false;
    callback back();
    callback settings();
    height: 52px;
    alignment: space-between;
    HorizontalLayout {
        alignment: start;
        if root.has-back: Rectangle {
            width: 120px;
            Text {
                x: 0px;
                width: parent.width;
                text: root.back-text;
                color: Brand.accent;
                font-size: 16px;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
            TouchArea { clicked => { root.back(); } }
        }
        if !root.has-back: Text {
            text: root.title;
            color: Brand.ink;
            font-size: 24px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    if root.has-settings: Rectangle {
        width: 52px;
        Text { text: "⚙"; font-size: 22px; color: Brand.muted; }
        TouchArea { clicked => { root.settings(); } }
    }
}

component Avatar inherits Rectangle {
    in property <string> letter;
    width: Metrics.avatar;
    height: Metrics.avatar;
    border-radius: Metrics.avatar / 2;
    border-width: 1.5px;
    border-color: Brand.accent;
    background: transparent;
    Text {
        text: root.letter;
        color: Brand.accent;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Round button with one glyph (`…`, `+`), 32px, surface fill.
component RoundButton inherits Rectangle {
    in property <string> glyph;
    in property <length> size: HomeMetrics.float-btn;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: self.width / 2;
    background: Brand.surface;
    border-width: 1px;
    border-color: Brand.border;
    Text { text: root.glyph; color: Brand.ink; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

// 160px preview tile (radius 32) with the avatar, then the inline note.
component AvatarPreview inherits VerticalLayout {
    in property <image> glyph;
    in property <string> note;
    spacing: 8px;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: AvatarMetrics.preview;
            height: AvatarMetrics.preview;
            border-radius: AvatarMetrics.preview-radius;
            background: Brand.rule;
            Image { source: root.glyph; width: AvatarMetrics.preview-glyph; height: AvatarMetrics.preview-glyph; }
        }
    }
    // UI姐: one line under the preview, no pop-up.
    if root.note != "": Text {
        text: root.note;
        color: Brand.danger;
        font-size: 13px;
        horizontal-alignment: center;
        overflow: elide;
    }
}

// 12 shapes, six per row (48px cells, 12px gap, two rows), then 10
// colours as 32px circles in 44px hit areas. A phone is too narrow for
// ten 44px targets in one row, so colours wrap five per row.
component AvatarPicker inherits VerticalLayout {
    in property <[PickerCell]> shapes;
    in property <[PickerCell]> swatches;
    callback pick-shape(int);
    callback pick-color(int);
    // Same 8px as the desktop picker (label to grid, label to swatches).
    // vertical-stretch stays 0 so leftover page height cannot inflate
    // the labels and open a ~40px gap under 「形状」 / 「颜色」.
    spacing: 8px;
    alignment: start;
    vertical-stretch: 0;
    property <int> shape-cols: 6;
    property <length> gap: 12px;
    Text { text: Tr.shape; color: Brand.text3; font-size: 13px; vertical-stretch: 0; }
    Rectangle {
        height: 2 * AvatarMetrics.cell + root.gap;
        vertical-stretch: 0;
        for c[i] in root.shapes: Rectangle {
            x: mod(i, root.shape-cols) * (AvatarMetrics.cell + root.gap);
            y: floor(i / root.shape-cols) * (AvatarMetrics.cell + root.gap);
            width: AvatarMetrics.cell;
            height: AvatarMetrics.cell;
            border-radius: AvatarMetrics.cell / 4;
            background: Brand.surface;
            border-width: c.selected ? AvatarMetrics.ring : 1px;
            border-color: c.selected ? Brand.ink : Brand.border;
            Image { source: c.glyph; width: AvatarMetrics.cell-glyph; height: AvatarMetrics.cell-glyph; }
            TouchArea { clicked => { root.pick-shape(i); } }
        }
    }
    // Layout spacing is 8px on both sides of this 8px spacer, so the
    // gap between the shape grid and 「颜色」 is 24px. Label-to-content
    // stays 8px.
    Rectangle { height: 8px; vertical-stretch: 0; }
    Text { text: Tr.color; color: Brand.text3; font-size: 13px; vertical-stretch: 0; }
    Rectangle {
        property <length> step: (self.width - 5 * AvatarMetrics.swatch-hit) / 4 + AvatarMetrics.swatch-hit;
        height: 2 * AvatarMetrics.swatch-hit;
        vertical-stretch: 0;
        for c[i] in root.swatches: Rectangle {
            x: mod(i, 5) * parent.step;
            y: floor(i / 5) * AvatarMetrics.swatch-hit;
            width: AvatarMetrics.swatch-hit;
            height: AvatarMetrics.swatch-hit;
            if c.selected: Rectangle {
                width: AvatarMetrics.swatch + 4 * AvatarMetrics.ring;
                height: self.width;
                border-radius: self.width / 2;
                border-width: AvatarMetrics.ring;
                border-color: Brand.ink;
            }
            Rectangle {
                width: AvatarMetrics.swatch;
                height: AvatarMetrics.swatch;
                border-radius: self.width / 2;
                background: c.fill;
            }
            TouchArea { clicked => { root.pick-color(i); } }
        }
    }
}

component MenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();
    width: 100%;
    height: HomeMetrics.menu-row;
    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.label;
        color: root.danger ? Brand.danger : Brand.ink;
        font-size: HomeMetrics.menu-text;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component MainWindow inherits Window {
    // 0 connect, 1 sessions, 2 card, 3 settings, 4 create bro, 5 avatar
    in-out property <int> screen: 0;
    in-out property <string> host-url;
    in-out property <string> token;
    in-out property <bool> show-token: false;
    in-out property <bool> token-masked: false;
    in property <string> error-title;
    in property <string> error;
    in property <string> unencrypted-hint;
    in property <bool> busy: false;
    in property <[SessionRow]> sessions;
    in property <[ChatRow]> chat;
    in property <string> chat-title;
    in property <string> chat-note;
    in-out property <string> composer-draft;
    in property <string> composer-hint;
    in-out property <bool> composer-focused: false;
    // Reserved: show the 56px thumbnail row when this is > 0.
    in property <int> attachment-count: 0;
    in property <int> locale-index;
    in property <int> theme-index;
    in property <string> version-text;
    // Chat title capsule: up to three 24px avatars as one image (first on
    // top), its width in px (0 = none), then `title-more` as "+N".
    in property <image> title-avatars;
    in property <float> title-avatars-width;
    in property <int> title-more;
    // Only the bro's owner sees the avatar entry (`…`).
    in property <bool> can-edit-avatar;
    // Working row above the composer; width 0 hides the avatar stack.
    in property <string> working-row;
    in property <image> working-avatars;
    in property <float> working-avatars-width;
    // Reconnecting banner, empty when the stream is fine or the outage is brief.
    in property <string> reconnect-banner;
    in property <int> unread-other;
    in property <bool> group-menu: false;
    in property <bool> self-menu: false;
    in property <bool> can-manage: false;
    in property <bool> delete-open: false;
    in property <bool> copied: false;
    in property <string> group-note;
    in-out property <string> group-edit;
    in property <bool> group-editing: false;
    in property <bool> group-edit-saving: false;
    in property <int> routines-on: -1;
    in property <int> member-count: -1;
    in property <string> me-name;
    in property <string> main-bro-name;
    in property <image> main-bro-glyph;
    in property <bool> has-main-bro: false;
    in-out property <string> home-query;
    in property <image> profile-avatars;
    in property <float> profile-avatars-width;
    in property <int> profile-more;
    in property <[FindHit]> find-hits;
    in-out property <string> find-query;
    in property <bool> find-busy: false;
    in property <[MemberLine]> members-list;
    // Create-bro (screen 4) and avatar (screen 5) pages.
    in property <image> avatar-preview;
    in property <string> avatar-note;
    in property <string> avatar-name;
    in property <bool> avatar-stored;
    in property <bool> avatar-busy;
    in property <[PickerCell]> picker-shapes;
    in property <[PickerCell]> picker-swatches;
    in-out property <string> new-bro-name;
    // Added on top of Window.safe-area-insets so desktop shots can show
    // typical phone insets (the desktop backend reports 0).
    in property <length> extra-safe-top: 0px;
    in property <length> extra-safe-bottom: 0px;
    // Palette follows the OS; Rust uses this when Appearance is System.
    out property <bool> os-dark: Palette.color-scheme == ColorScheme.dark;
    callback connect();
    callback host-changed();
    callback token-changed();
    callback toggle-show-token();
    callback open-session(string, string);
    callback back();
    callback open-settings();
    callback set-locale(int);
    callback set-theme(int);
    callback theme-follow-system();
    callback send();
    callback open-new-bro();
    callback open-avatar();
    callback pick-shape(int);
    callback pick-color(int);
    callback avatar-reset();
    callback create-bro();
    callback page-back();
    callback toggle-process(string);
    callback open-group-menu();
    callback close-menus();
    callback open-group-profile();
    callback open-find();
    callback find-edited();
    callback open-members();
    callback start-edit();
    callback save-edit();
    callback copy-id();
    callback ask-delete();
    callback cancel-delete();
    callback confirm-delete();
    callback open-self-menu();
    callback sign-out();
    callback home-search-edited();
    callback open-hit(string);

    changed os-dark => { root.theme-follow-system(); }

    background: Brand.paper;
    preferred-width: 390px;
    preferred-height: 844px;
    min-width: 390px;
    min-height: 844px;

    VerticalLayout {
        padding-left: root.screen == 2 ? Metrics.column-margin : 20px;
        padding-right: root.screen == 2 ? Metrics.column-margin : 20px;
        padding-top: 20px + root.safe-area-insets.top + root.extra-safe-top;
        padding-bottom: root.screen == 2 ? 0 : (20px + root.safe-area-insets.bottom + root.extra-safe-bottom);
        spacing: 14px;

        if root.screen == 0: VerticalLayout {
            spacing: 16px;
            alignment: start;
            Header { title: "robroz"; has-settings: true; settings => { root.open-settings(); } }
            Field {
                label: Tr.label-host;
                value <=> root.host-url;
                placeholder: "https://…";
                edited => { root.host-changed(); }
            }
            if root.unencrypted-hint != "": Text {
                text: root.unencrypted-hint;
                color: Brand.muted;
                wrap: word-wrap;
                font-size: 13px;
            }
            Field {
                label: Tr.label-token;
                value <=> root.token;
                secret: !root.show-token && !root.token-masked;
                reveal-text: root.token-masked ? "" : (root.show-token ? Tr.hide : Tr.show);
                reveal => { root.toggle-show-token(); }
                edited => { root.token-changed(); }
            }
            Pill {
                text: root.busy ? Tr.connecting : Tr.connect;
                clicked => { if !root.busy { root.connect(); } }
            }
            if root.error-title != "" || root.error != "": VerticalLayout {
                spacing: 4px;
                if root.error-title != "": Text {
                    text: root.error-title;
                    color: Brand.accent;
                    wrap: word-wrap;
                    font-size: 13px;
                    font-weight: 600;
                }
                if root.error != "": Text {
                    text: root.error;
                    color: Brand.accent;
                    wrap: word-wrap;
                    font-size: 13px;
                }
            }
        }

        if root.screen == 1: Rectangle {
            VerticalLayout {
                spacing: 12px;
                // Main bro, 96px, with the + button over the top-right.
                Rectangle {
                    height: HomeMetrics.main-bro + HomeMetrics.main-bro-name + 8px;
                    if root.has-main-bro: VerticalLayout {
                        spacing: 8px;
                        alignment: start;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: root.main-bro-glyph;
                                width: HomeMetrics.main-bro;
                                height: HomeMetrics.main-bro;
                            }
                        }
                        Text {
                            text: root.main-bro-name;
                            color: Brand.ink;
                            font-size: HomeMetrics.main-bro-name;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                    if !root.has-main-bro && root.sessions.length == 0: Text {
                        y: (parent.height - self.height) / 2;
                        width: 100%;
                        text: Tr.empty-chats;
                        color: Brand.muted;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    RoundButton {
                        x: parent.width - self.width;
                        y: 0px;
                        glyph: "+";
                        clicked => { root.open-new-bro(); }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for s in root.sessions: Rectangle {
                        height: HomeMetrics.row;
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: stretch;
                            VerticalLayout {
                                alignment: center;
                                width: HomeMetrics.row-avatar;
                                if s.has-glyph: Image {
                                    source: s.glyph;
                                    width: HomeMetrics.row-avatar;
                                    height: HomeMetrics.row-avatar;
                                }
                                if !s.has-glyph: Rectangle {
                                    width: HomeMetrics.row-avatar;
                                    height: HomeMetrics.row-avatar;
                                    border-radius: HomeMetrics.row-avatar / 2;
                                    background: Brand.surface;
                                    border-width: 1px;
                                    border-color: Brand.border;
                                }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                alignment: center;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: s.name;
                                        color: Brand.ink;
                                        font-size: HomeMetrics.row-name;
                                        font-weight: 700;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        width: 52px;
                                        Text {
                                            text: s.time;
                                            color: Brand.text3;
                                            font-size: HomeMetrics.row-time;
                                            horizontal-alignment: right;
                                        }
                                        if s.unread > 0: HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: HomeMetrics.unread-dot;
                                                height: HomeMetrics.unread-dot;
                                                border-radius: HomeMetrics.unread-dot / 2;
                                                background: Brand.accent;
                                            }
                                        }
                                    }
                                }
                                Text {
                                    text: s.preview;
                                    color: Brand.muted;
                                    font-size: HomeMetrics.row-preview;
                                    overflow: elide;
                                }
                            }
                        }
                        TouchArea { clicked => { root.open-session(s.id, s.name); } }
                    }
                }
                // Self row + search capsule, 16px off the bottom (layout
                // padding already includes the safe area).
                Rectangle {
                    height: HomeMetrics.card-row;
                    border-radius: HomeMetrics.menu-r;
                    background: Brand.surface;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: root.me-name;
                            color: Brand.ink;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    TouchArea { clicked => { root.open-self-menu(); } }
                }
                Rectangle {
                    height: HomeMetrics.search;
                    border-radius: HomeMetrics.search / 2;
                    background: Brand.surface;
                    border-width: 1px;
                    border-color: Brand.border;
                    if root.home-query == "": Text {
                        x: 16px;
                        width: parent.width - 32px;
                        height: 100%;
                        text: Tr.search-placeholder;
                        color: Brand.muted;
                        font-size: 15px;
                        vertical-alignment: center;
                    }
                    TextInput {
                        x: 16px;
                        width: parent.width - 32px;
                        height: 100%;
                        text <=> root.home-query;
                        color: Brand.ink;
                        font-size: 15px;
                        single-line: true;
                        vertical-alignment: center;
                        edited => { root.home-search-edited(); }
                    }
                }
                Rectangle { height: HomeMetrics.search-lift; }
            }
            if root.self-menu: Rectangle {
                x: 0px;
                width: 100%;
                height: 100%;
                TouchArea { clicked => { root.close-menus(); } }
                Rectangle {
                    x: parent.width - HomeMetrics.menu-w;
                    y: parent.height - HomeMetrics.search - HomeMetrics.search-lift - HomeMetrics.card-row - HomeMetrics.menu-gap - (2 * HomeMetrics.menu-row + 1px);
                    width: HomeMetrics.menu-w;
                    border-radius: HomeMetrics.menu-r;
                    background: Brand.surface;
                    border-width: 1px;
                    border-color: Brand.border;
                    VerticalLayout {
                        MenuRow { label: Tr.settings-title; clicked => { root.close-menus(); root.open-settings(); } }
                        Rectangle { height: 1px; background: Brand.rule; }
                        MenuRow { label: Tr.sign-out; danger: true; clicked => { root.sign-out(); } }
                    }
                }
            }
        }

        if root.screen == 2: VerticalLayout {
            spacing: 10px;
            width: 100%;
            HorizontalLayout {
                spacing: 8px;
                height: AvatarMetrics.title-height;
                Rectangle {
                    horizontal-stretch: 0;
                    border-radius: HomeMetrics.float-btn / 2;
                    background: Brand.paper;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 4px;
                        Text {
                            text: "‹";
                            color: Brand.ink;
                            font-size: 22px;
                            vertical-alignment: center;
                        }
                        if root.unread-other > 0: Text {
                            text: root.unread-other > 99 ? "99+" : root.unread-other;
                            color: Brand.ink;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea { clicked => { root.back(); } }
                }
                Rectangle {
                    horizontal-stretch: 0;
                    border-radius: self.height / 2;
                    background: Brand.surface;
                    border-width: 1px;
                    border-color: Brand.border;
                    HorizontalLayout {
                        padding-left: root.title-avatars-width > 0 ? AvatarMetrics.title-pad : 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        if root.title-avatars-width > 0: VerticalLayout {
                            alignment: center;
                            width: root.title-avatars-width * 1px;
                            Image {
                                source: root.title-avatars;
                                width: root.title-avatars-width * 1px;
                                height: AvatarMetrics.title-size;
                            }
                        }
                        if root.title-more > 0: Text {
                            text: "+" + root.title-more;
                            color: Brand.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.chat-title;
                            color: Brand.ink;
                            font-size: 17px;
                            font-weight: 700;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    RoundButton { glyph: "…"; clicked => { root.open-group-menu(); } }
                }
            }
            if root.group-menu: HorizontalLayout {
                width: 100%;
                alignment: end;
                Rectangle {
                    width: HomeMetrics.menu-w;
                    border-radius: HomeMetrics.menu-r;
                    background: Brand.surface;
                    border-width: 1px;
                    border-color: Brand.border;
                    VerticalLayout {
                        MenuRow { label: Tr.menu-profile; clicked => { root.open-group-profile(); } }
                        MenuRow { label: Tr.menu-find; clicked => { root.open-find(); } }
                        if root.can-manage: Rectangle { height: 1px; background: Brand.rule; }
                        if root.can-manage: MenuRow { label: Tr.menu-delete; danger: true; clicked => { root.ask-delete(); } }
                    }
                }
            }
            if root.chat-note != "": Text { text: root.chat-note; color: Brand.muted; wrap: word-wrap; }
            if root.reconnect-banner != "": HorizontalLayout {
                width: 100%;
                alignment: center;
                padding-top: 4px;
                padding-bottom: 8px;
                Rectangle {
                    border-radius: 12px;
                    background: Brand.surface;
                    border-width: 1px;
                    border-color: Brand.border;
                    HorizontalLayout {
                        padding-top: 4px;
                        padding-bottom: 4px;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: start;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            // Same token as the 「卡住」 (stuck) dot, not brand orange.
                            background: Brand.stuck;
                        }
                        Text {
                            text: root.reconnect-banner;
                            color: Brand.ink;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            ScrollView {
                vertical-stretch: 1;
                width: 100%;
                feed := VerticalLayout {
                    width: 100%;
                    spacing: 0px;
                    alignment: start;
                    property <length> col-w: self.width;
                    property <length> gutter: Metrics.avatar + Metrics.avatar-gap;
                    for row in root.chat: VerticalLayout {
                        width: 100%;
                        padding-top: row.pad-top;
                        if row.kind == 3: Text {
                            width: 100%;
                            text: row.text;
                            color: Brand.text3;
                            font-size: Metrics.date-size;
                            horizontal-alignment: center;
                        }
                        if row.kind == 0: HorizontalLayout {
                            width: 100%;
                            alignment: end;
                            VerticalLayout {
                                spacing: 2px;
                                alignment: end;
                                Rectangle {
                                    background: Brand.own-bg;
                                    border-radius: Metrics.bubble-radius;
                                    max-width: feed.col-w * 0.75;
                                    VerticalLayout {
                                        padding-left: Metrics.bubble-pad-h;
                                        padding-right: Metrics.bubble-pad-h;
                                        padding-top: Metrics.bubble-pad-v;
                                        padding-bottom: Metrics.bubble-pad-v;
                                        Text {
                                            text: row.text;
                                            color: Brand.own-text;
                                            font-size: Metrics.bubble-mine-size;
                                            wrap: word-wrap;
                                            horizontal-alignment: left;
                                        }
                                    }
                                }
                                if row.time != "": Text {
                                    text: row.time;
                                    color: Brand.text3;
                                    font-size: Metrics.time-size;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                        if row.kind == 1: VerticalLayout {
                            width: 100%;
                            spacing: 2px;
                            HorizontalLayout {
                                width: 100%;
                                alignment: start;
                                vertical-stretch: 0;
                                VerticalLayout {
                                    width: Metrics.avatar;
                                    alignment: end;
                                    vertical-stretch: 1;
                                    if row.show-avatar && row.has-glyph: Image { source: row.glyph; width: Metrics.avatar; height: Metrics.avatar; }
                                    if row.show-avatar && !row.has-glyph: Avatar { letter: row.initial; }
                                    if !row.show-avatar: Rectangle { width: Metrics.avatar; height: 1px; }
                                }
                                Rectangle { width: Metrics.avatar-gap; }
                                VerticalLayout {
                                    spacing: 3px;
                                    max-width: feed.col-w - feed.gutter;
                                    if row.show-name: Text {
                                        text: row.name;
                                        color: Brand.muted;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        background: Brand.surface;
                                        border-radius: Metrics.bubble-radius;
                                        border-width: 1px;
                                        border-color: Brand.border;
                                        VerticalLayout {
                                            padding-left: Metrics.bubble-pad-h;
                                            padding-right: Metrics.bubble-pad-h;
                                            padding-top: Metrics.bubble-pad-v;
                                            padding-bottom: Metrics.bubble-pad-v;
                                            Text {
                                                text: row.text;
                                                color: Brand.ink;
                                                font-size: 16px;
                                                wrap: word-wrap;
                                                horizontal-alignment: left;
                                            }
                                        }
                                    }
                                }
                            }
                            if row.time != "": HorizontalLayout {
                                width: 100%;
                                Rectangle { width: feed.gutter; }
                                Text {
                                    text: row.time;
                                    color: Brand.text3;
                                    font-size: Metrics.time-size;
                                    horizontal-alignment: left;
                                }
                            }
                        }
                        if row.kind == 2: VerticalLayout {
                            width: 100%;
                            spacing: 2px;
                            HorizontalLayout {
                                width: 100%;
                                alignment: start;
                                VerticalLayout {
                                    width: Metrics.avatar;
                                    alignment: end;
                                    vertical-stretch: 1;
                                    if row.show-avatar && row.has-glyph: Image { source: row.glyph; width: Metrics.avatar; height: Metrics.avatar; }
                                    if row.show-avatar && !row.has-glyph: Avatar { letter: row.initial; }
                                    if !row.show-avatar: Rectangle { width: Metrics.avatar; height: 1px; }
                                }
                                Rectangle { width: Metrics.avatar-gap; }
                                VerticalLayout {
                                    spacing: 3px;
                                    max-width: feed.col-w - feed.gutter;
                                    if row.show-name: Text {
                                        text: row.name;
                                        color: Brand.muted;
                                        font-size: 12px;
                                    }
                                    HorizontalLayout {
                                        // Fixed column width (not parent.width) so shrink
                                        // cards do not form a binding loop.
                                        width: feed.col-w - feed.gutter;
                                        alignment: start;
                                        Rectangle {
                                            // Unfilled status card: border only.
                                            // Line-only cards shrink to content; others fill the column.
                                            horizontal-stretch: row.status-shrink ? 0 : 1;
                                            background: transparent;
                                            border-radius: 14px;
                                            border-width: 1px;
                                            border-color: Brand.border;
                                            VerticalLayout {
                                                padding: 14px;
                                                spacing: 4px;
                                                alignment: start;
                                                HorizontalLayout {
                                                    alignment: start;
                                                    spacing: 8px;
                                                    Rectangle {
                                                        width: 8px;
                                                        height: 8px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 4px;
                                                        background: row.dot;
                                                    }
                                                    if row.step != "": Text {
                                                        text: row.step;
                                                        color: Brand.ink;
                                                        font-size: 14px;
                                                        horizontal-alignment: left;
                                                        vertical-alignment: center;
                                                    }
                                                    if row.status-runs.length == 0: Text {
                                                        text: row.status;
                                                        color: Brand.ink;
                                                        font-size: 14px;
                                                        font-weight: 600;
                                                        wrap: word-wrap;
                                                        horizontal-alignment: left;
                                                        vertical-alignment: center;
                                                    }
                                                    if row.status-runs.length > 0: HorizontalLayout {
                                                        alignment: start;
                                                        spacing: 0px;
                                                        for run in row.status-runs: HorizontalLayout {
                                                            if run.mono: Text {
                                                                text: run.text;
                                                                color: Brand.ink;
                                                                font-size: 14px;
                                                                font-weight: 600;
                                                                font-family: Metrics.mono-font;
                                                                vertical-alignment: center;
                                                            }
                                                            if !run.mono: Text {
                                                                text: run.text;
                                                                color: Brand.ink;
                                                                font-size: 14px;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                    if row.expandable: Text {
                                                        text: "›";
                                                        color: Brand.text3;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                if row.expandable: TouchArea {
                                                    clicked => { root.toggle-process(row.task-id); }
                                                }
                                                if row.progress != "": Text {
                                                    text: row.progress;
                                                    color: Brand.ink;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                    horizontal-alignment: left;
                                                }
                                                if row.detail != "": TextInput {
                                                    text: row.detail;
                                                    read-only: true;
                                                    color: Brand.text3;
                                                    font-size: 12px;
                                                    font-family: Metrics.mono-font;
                                                    wrap: word-wrap;
                                                    horizontal-alignment: left;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if row.time != "": HorizontalLayout {
                                width: 100%;
                                Rectangle { width: feed.gutter; }
                                Text {
                                    text: row.time;
                                    color: Brand.text3;
                                    font-size: Metrics.time-size;
                                    horizontal-alignment: left;
                                }
                            }
                        }
                    }
                }
            }
            if root.working-row != "": HorizontalLayout {
                padding-top: 8px;
                // Text bottom to composer top is 8px.
                padding-bottom: 8px;
                spacing: 8px;
                alignment: start;
                if root.working-avatars-width > 0: Image {
                    source: root.working-avatars;
                    width: root.working-avatars-width * 1px;
                    height: 16px;
                }
                Text {
                    text: root.working-row;
                    color: Brand.text3;
                    font-size: 12px;
                    vertical-alignment: bottom;
                    overflow: elide;
                }
            }
            Rectangle {
                width: 100%;
                border-radius: Metrics.composer-radius;
                border-width: 1px;
                border-color: Brand.border;
                background: Brand.surface;
                VerticalLayout {
                    // Reserved 56px attachment-thumbnail row. Hidden while
                    // there are no attachments (the feature is not wired).
                    if root.attachment-count > 0: Rectangle {
                        height: Metrics.thumb-size;
                    }
                    HorizontalLayout {
                        padding-left: Metrics.composer-pad-left;
                        padding-right: Metrics.composer-send-inset;
                        padding-top: Metrics.composer-send-inset;
                        padding-bottom: Metrics.composer-send-inset;
                        min-height: Metrics.composer-height;
                        spacing: 8px;
                        // stretch (not start/end) so horizontal-stretch is
                        // honoured; start/end pack children and ignore
                        // stretch, which pushed a short hint against the
                        // send button. Left inset is 16px, same as desktop.
                        alignment: stretch;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: Metrics.composer-send;
                            if root.composer-draft == "" && !root.composer-focused: HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                alignment: start;
                                Text {
                                    height: 100%;
                                    text: root.composer-hint;
                                    color: Brand.text3;
                                    font-size: 16px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle { horizontal-stretch: 1; height: 1px; }
                            }
                            if root.composer-draft == "" && !root.composer-focused: TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.composer-focused = true; }
                            }
                            if root.composer-draft != "" || root.composer-focused: TextInput {
                                width: 100%;
                                height: 100%;
                                text <=> root.composer-draft;
                                color: Brand.ink;
                                font-size: 16px;
                                single-line: true;
                                vertical-alignment: center;
                                init => { self.focus(); }
                                accepted => {
                                    if root.composer-draft != "" { root.send(); }
                                    if root.composer-draft == "" { root.composer-focused = false; }
                                }
                            }
                        }
                        Rectangle {
                            width: Metrics.composer-send;
                            height: Metrics.composer-send;
                            border-radius: Metrics.composer-send / 2;
                            background: Brand.accent-strong;
                            opacity: root.composer-draft == "" ? Metrics.composer-send-empty-opacity : 1;
                            Text { text: "↑"; color: Brand.on-accent; font-size: 16px; }
                            if root.composer-draft != "": TouchArea { clicked => { root.send(); } }
                        }
                    }
                }
            }
            Rectangle {
                height: Metrics.composer-bottom + root.safe-area-insets.bottom + root.extra-safe-bottom;
            }
        }

        if root.screen == 4: VerticalLayout {
            spacing: 16px;
            HorizontalLayout {
                height: 52px;
                Text { text: Tr.add-bro; color: Brand.ink; font-size: 20px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: Tr.cancel;
                    color: Brand.accent;
                    font-size: 16px;
                    vertical-alignment: center;
                    TouchArea { clicked => { root.page-back(); } }
                }
            }
            AvatarPreview { glyph: root.avatar-preview; note: root.avatar-note; }
            Rectangle {
                height: AvatarMetrics.name-height;
                border-radius: AvatarMetrics.name-radius;
                background: Brand.surface;
                border-width: 1px;
                border-color: name-input.has-focus ? Brand.accent : Brand.border;
                if root.new-bro-name == "": Text {
                    x: 16px;
                    width: parent.width - 32px;
                    height: 100%;
                    text: Tr.name-placeholder;
                    color: Brand.muted;
                    font-size: 16px;
                    vertical-alignment: center;
                }
                name-input := TextInput {
                    x: 16px;
                    width: parent.width - 32px;
                    height: 100%;
                    text <=> root.new-bro-name;
                    color: Brand.ink;
                    font-size: 16px;
                    single-line: true;
                    vertical-alignment: center;
                    enabled: !root.avatar-busy;
                    accepted => { if root.new-bro-name != "" { root.create-bro(); } }
                }
            }
            AvatarPicker {
                shapes: root.picker-shapes;
                swatches: root.picker-swatches;
                pick-shape(i) => { root.pick-shape(i); }
                pick-color(i) => { root.pick-color(i); }
            }
            Rectangle { vertical-stretch: 1; }
            Rectangle {
                height: AvatarMetrics.name-height;
                border-radius: AvatarMetrics.name-radius;
                background: Brand.accent;
                opacity: (root.new-bro-name == "" || root.avatar-busy) ? AvatarMetrics.create-empty-opacity : 1;
                Text { text: Tr.create; color: Brand.on-accent; font-size: 16px; font-weight: 600; }
                TouchArea { clicked => { if root.new-bro-name != "" && !root.avatar-busy { root.create-bro(); } } }
            }
        }

        if root.screen == 5: VerticalLayout {
            spacing: 16px;
            HorizontalLayout {
                height: 52px;
                Text { text: Tr.avatar-title; color: Brand.ink; font-size: 20px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; RoundButton { glyph: "‹"; clicked => { root.page-back(); } } }
            }
            AvatarPreview { glyph: root.avatar-preview; note: root.avatar-note; }
            Text { text: root.avatar-name; color: Brand.ink; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
            AvatarPicker {
                shapes: root.picker-shapes;
                swatches: root.picker-swatches;
                pick-shape(i) => { root.pick-shape(i); }
                pick-color(i) => { root.pick-color(i); }
            }
            Rectangle { vertical-stretch: 1; }
            if root.avatar-stored: Rectangle {
                height: AvatarMetrics.name-height;
                border-radius: AvatarMetrics.name-radius;
                background: Brand.surface;
                border-width: 1px;
                border-color: Brand.border;
                Text { text: Tr.use-default; color: Brand.ink; font-size: 16px; }
                TouchArea { clicked => { root.avatar-reset(); } }
            }
        }

        if root.screen == 3: VerticalLayout {
            spacing: 14px;
            Header { has-back: true; back-text: Tr.back; back => { root.back(); } }
            Text { text: Tr.settings; color: Brand.ink; font-size: 24px; font-weight: 700; }
            Text { text: Tr.language; color: Brand.muted; font-size: 13px; }
            SegmentBar {
                left-text: Tr.locale-en;
                right-text: Tr.locale-zh;
                selected: root.locale-index;
                picked(i) => { root.set-locale(i); }
            }
            Text { text: Tr.appearance; color: Brand.muted; font-size: 13px; }
            SegmentBar {
                left-text: Tr.theme-system;
                mid-text: Tr.theme-light;
                right-text: Tr.theme-dark;
                selected: root.theme-index;
                picked(i) => { root.set-theme(i); }
            }
            Rectangle { vertical-stretch: 1; }
            // About: the Slint attribution slot, at the very bottom of Settings.
            Text { text: Tr.about; color: Brand.muted; font-size: 13px; }
            Text { text: root.version-text; color: Brand.ink; font-size: 15px; }
            Rectangle {
                height: 160px;
                AboutSlint { }
            }
        }

        if root.screen == 6: VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                height: HomeMetrics.float-btn;
                RoundButton { glyph: "‹"; clicked => { root.back(); } }
                Rectangle { horizontal-stretch: 1; }
                RoundButton { glyph: "…"; clicked => { root.open-group-menu(); } }
            }
            if root.group-menu: HorizontalLayout {
                width: 100%;
                alignment: end;
                Rectangle {
                    width: HomeMetrics.menu-w;
                    border-radius: HomeMetrics.menu-r;
                    background: Brand.surface;
                    border-width: 1px;
                    border-color: Brand.border;
                    VerticalLayout {
                        MenuRow { label: Tr.profile-copy-id; clicked => { root.copy-id(); } }
                        if root.can-manage: Rectangle { height: 1px; background: Brand.rule; }
                        if root.can-manage: MenuRow { label: Tr.menu-delete; danger: true; clicked => { root.ask-delete(); } }
                    }
                }
            }
            VerticalLayout {
                spacing: HomeMetrics.profile-name-gap;
                alignment: center;
                if root.profile-avatars-width > 0: Image {
                    source: root.profile-avatars;
                    width: root.profile-avatars-width * 1px;
                    height: HomeMetrics.profile-avatar;
                }
                if  !root.group-editing: Text {
                    text: root.chat-title;
                    color: Brand.ink;
                    font-size: HomeMetrics.profile-name;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                if root.group-editing: Rectangle {
                    height: HomeMetrics.profile-edit-h;
                    width: 220px;
                    border-radius: 16px;
                    background: Brand.surface;
                    border-width: 1px;
                    border-color: Brand.border;
                    TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: 100%;
                        text <=> root.group-edit;
                        color: Brand.ink;
                        font-size: 16px;
                        single-line: true;
                        vertical-alignment: center;
                        accepted => { root.save-edit(); }
                    }
                }
                if root.can-manage &&  !root.group-editing: Rectangle {
                    height: HomeMetrics.profile-edit-h;
                    width: 80px;
                    border-radius: HomeMetrics.profile-edit-h / 2;
                    background: Brand.surface;
                    Text { text: Tr.profile-edit; color: Brand.ink; font-size: 13px; }
                    TouchArea { clicked => { root.start-edit(); } }
                }
                if root.can-manage && root.group-editing: Rectangle {
                    height: HomeMetrics.profile-edit-h;
                    width: 80px;
                    border-radius: HomeMetrics.profile-edit-h / 2;
                    background: Brand.accent;
                    Text { text: Tr.create; color: Brand.on-accent; font-size: 13px; }
                    TouchArea { clicked => { if !root.group-edit-saving { root.save-edit(); } } }
                }
            }
            if root.copied: Text {
                text: Tr.profile-copied;
                color: Brand.muted;
                font-size: 13px;
                horizontal-alignment: center;
            }
            if root.group-note != "": Text {
                text: root.group-note;
                color: Brand.danger;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Rectangle {
                border-radius: HomeMetrics.card-r;
                background: Brand.surface;
                VerticalLayout {
                    if root.routines-on >= 0: Rectangle {
                        height: HomeMetrics.card-row;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            Text { text: Tr.profile-routines; color: Brand.ink; font-size: 16px; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: root.routines-on; color: Brand.muted; font-size: 14px; vertical-alignment: center; }
                        }
                    }
                    if root.member-count >= 0 && root.can-manage: Rectangle {
                        height: HomeMetrics.card-row;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            Text { text: Tr.profile-members; color: Brand.ink; font-size: 16px; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: root.member-count; color: Brand.muted; font-size: 14px; vertical-alignment: center; }
                            Text { text: "›"; color: Brand.text3; font-size: 18px; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.open-members(); } }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }

        if root.screen == 7: VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                height: HomeMetrics.float-btn;
                spacing: 8px;
                RoundButton { glyph: "‹"; clicked => { root.back(); } }
                Text { text: Tr.find-title; color: Brand.ink; font-size: 20px; font-weight: 700; vertical-alignment: center; }
            }
            Rectangle {
                height: HomeMetrics.search;
                border-radius: HomeMetrics.search / 2;
                background: Brand.surface;
                border-width: 1px;
                border-color: Brand.border;
                if root.find-query == "": Text {
                    x: 16px; width: parent.width - 32px; height: 100%;
                    text: Tr.find-placeholder; color: Brand.muted; font-size: 15px; vertical-alignment: center;
                }
                TextInput {
                    x: 16px; width: parent.width - 32px; height: 100%;
                    text <=> root.find-query; color: Brand.ink; font-size: 15px;
                    single-line: true; vertical-alignment: center;
                    edited => { root.find-edited(); }
                    accepted => { root.find-edited(); }
                }
            }
            if root.find-hits.length == 0: Text {
                text: root.find-busy ? "" : (root.find-query == "" ? Tr.find-empty : Tr.find-no-results);
                color: Brand.muted;
                wrap: word-wrap;
            }
            ListView {
                for h in root.find-hits: Rectangle {
                    height: 72px;
                    VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        HorizontalLayout {
                            Text { text: h.author; color: Brand.ink; font-size: 14px; font-weight: 700; overflow: elide; horizontal-stretch: 1; }
                            Text { text: h.when; color: Brand.text3; font-size: 12px; }
                        }
                        Text { text: h.snippet; color: Brand.muted; font-size: 14px; overflow: elide; wrap: no-wrap; }
                    }
                    TouchArea { clicked => { root.open-hit(h.message-id); } }
                }
            }
        }

        if root.screen == 8: VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                height: HomeMetrics.float-btn;
                spacing: 8px;
                RoundButton { glyph: "‹"; clicked => { root.back(); } }
                Text { text: Tr.members-title; color: Brand.ink; font-size: 20px; font-weight: 700; vertical-alignment: center; }
            }
            ListView {
                for m in root.members-list: Rectangle {
                    height: HomeMetrics.card-row;
                    HorizontalLayout {
                        spacing: 12px;
                        padding-left: 4px;
                        padding-right: 4px;
                        if m.has-glyph: Image { source: m.glyph; width: 40px; height: 40px; }
                        if !m.has-glyph: Rectangle {
                            width: 40px; height: 40px; border-radius: 20px;
                            background: Brand.surface; border-width: 1px; border-color: Brand.border;
                        }
                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            Text { text: m.name; color: Brand.ink; font-size: 16px; overflow: elide; }
                            if m.detail != "": Text { text: m.detail; color: Brand.text3; font-size: 12px; overflow: elide; }
                        }
                    }
                }
            }
        }
    }

    if root.delete-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { clicked => { root.cancel-delete(); } }
        Rectangle {
            y: parent.height - self.height;
            width: 100%;
            border-top-left-radius: HomeMetrics.card-r;
            border-top-right-radius: HomeMetrics.card-r;
            background: Brand.paper;
            VerticalLayout {
                padding: 20px;
                padding-bottom: 20px + root.safe-area-insets.bottom + root.extra-safe-bottom;
                spacing: 12px;
                Text { text: Tr.delete-title; color: Brand.ink; font-size: 18px; font-weight: 700; wrap: word-wrap; }
                Text { text: Tr.delete-body; color: Brand.muted; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        height: 48px;
                        horizontal-stretch: 1;
                        border-radius: 10px;
                        background: Brand.surface;
                        Text { text: Tr.cancel; color: Brand.ink; font-size: 16px; font-weight: 600; }
                        TouchArea { clicked => { root.cancel-delete(); } }
                    }
                    Rectangle {
                        height: 48px;
                        horizontal-stretch: 1;
                        border-radius: 10px;
                        background: Brand.danger;
                        Text { text: Tr.menu-delete; color: #ffffff; font-size: 16px; font-weight: 600; }
                        TouchArea { clicked => { root.confirm-delete(); } }
                    }
                }
            }
        }
    }
}
